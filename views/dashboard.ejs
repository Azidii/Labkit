<!DOCTYPE html>
<html lang="en" data-auth="<%= locals.currentUser ? 'true' : 'false' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LabKit Market — Individual Parts for Engineers</title>
  <meta name="description"
    content="A marketplace for engineering students and hobbyists. Individual electronic parts sold as single units — buzzers, sensors, boards, motors and more." />
  <link rel="stylesheet" href="/css/dashboard.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/cart.css" />
  <link rel="stylesheet" href="/css/navbar-search.css" />
  <script src="/js/theme.js"></script>
  <script src="/js/page-transitions.js"></script>
</head>

<body>

  <header class="navbar">
    <div class="container navbar__inner">
      <a href="/" class="navbar__brand">
        <span class="navbar__logo-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <rect width="16" height="16" x="4" y="4" rx="2" />
            <rect width="6" height="6" x="9" y="9" />
            <path d="M15 2v2" />
            <path d="M15 20v2" />
            <path d="M2 15h2" />
            <path d="M2 9h2" />
            <path d="M20 15h2" />
            <path d="M20 9h2" />
            <path d="M9 2v2" />
            <path d="M9 20v2" />
          </svg>
        </span>
        <span class="navbar__wordmark">LabKit</span>
        <span class="navbar__sub">/MARKET</span>
      </a>

      <nav class="navbar__nav">
        <a href="/" class="navbar__link navbar__link--active">Home</a>
        <a href="/shop" class="navbar__link">Shop</a>
        <a href="/about" class="navbar__link">About Us</a>
      </nav>

      <div class="navbar__actions">
        <button type="button" class="navbar__icon-btn navbar__cart" id="openCartBtn" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1" />
            <circle cx="20" cy="21" r="1" />
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
          </svg>
          <span class="navbar__cart-badge" id="cartBadge" style="display: none;">0</span>
        </button>

        <% if (locals.currentUser) { %>
        <div class="profile-dropdown-wrapper">
          <button class="navbar__avatar-btn" id="avatarBtn" aria-label="User menu" aria-expanded="false">
            <% if (locals.currentUser.avatar) { %>
              <img src="<%= locals.currentUser.avatar %>" alt="User avatar" class="navbar__avatar" style="object-fit: cover; border-radius: 9999px;" />
            <% } else { %>
              <span class="navbar__avatar"><%= locals.currentUser.firstName ? locals.currentUser.firstName.charAt(0).toUpperCase() : 'U' %></span>
            <% } %>
            <svg class="navbar__avatar-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>

          <div class="profile-dropdown" id="profileDropdown">
            <div class="profile-dropdown__header">
              <p class="profile-dropdown__name"><%= locals.currentUser.firstName %> <%= locals.currentUser.lastName %></p>
              <p class="profile-dropdown__email"><%= locals.currentUser.email %></p>
            </div>
            <div class="profile-dropdown__divider"></div>
            <% if (locals.currentUser && (locals.currentUser.role === 'admin' || locals.userRole === 'admin')) { %>
            <a href="/admin" class="profile-dropdown__item profile-dropdown__item--admin">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span>Admin Dashboard</span>
            </a>
            <% } %>
            <a href="/settings" class="profile-dropdown__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3" />
                <path
                  d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
              </svg>
              <span>Settings</span>
            </a>
            <a href="/logout" class="profile-dropdown__item" onclick="localStorage.removeItem('userEmail'); localStorage.removeItem('userName'); localStorage.removeItem('theme'); document.documentElement.classList.remove('dark');">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              <span>Sign out</span>
            </a>
          </div>
        </div>
        <% } else { %>
        <a href="/login" class="navbar__login-btn">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="page-main">
    <!-- ── HERO ── -->
    <section class="hero">
      <div class="container hero__inner">
        <div class="hero__grid">
          <div class="hero__content">
            <div class="hero__tech-tag">
              <span class="hero__tech-tag-dot"></span>
              <span>Direct hardware sourcing for labs &amp; prototypes</span>
            </div>

            <h1 class="hero__title">
              Every part your project needs.
            </h1>

            <p class="hero__desc">
              Single-unit microcontrollers, sensors, buzzers, and wiring for engineering students and makers — bench-checked before dispatch with zero minimum order.
            </p>

            <div class="hero__actions">
              <a href="/shop" class="btn btn--primary hero__btn-primary">
                <span>Browse the shop</span>
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
              <a href="/about" class="btn btn--outline">
                How ordering works
              </a>
            </div>

            <div class="hero__spec-strip">
              <div class="hero__spec-col">
                <span class="hero__spec-val">100%</span>
                <span class="hero__spec-lbl">Bench tested</span>
              </div>
              <span class="hero__spec-divider" aria-hidden="true">/</span>
              <div class="hero__spec-col">
                <span class="hero__spec-val">1 Unit</span>
                <span class="hero__spec-lbl">Zero min order</span>
              </div>
              <span class="hero__spec-divider" aria-hidden="true">/</span>
              <div class="hero__spec-col">
                <span class="hero__spec-val">24h</span>
                <span class="hero__spec-lbl">Direct dispatch</span>
              </div>
            </div>
          </div>

          <div class="hero__media">
            <%
              const spotlights = (Array.isArray(featured) && featured.length > 0)
                ? featured.filter(p => Number(p.stockQuantity !== undefined ? p.stockQuantity : (p.stock || 0)) > 0).map((p) => ({
                    name: p.name,
                    category: p.category || "Sensors & Modules",
                    difficulty: p.difficulty || "Beginner",
                    spec: p.tagline || (p.description ? p.description.slice(0, 85) : "Bench-tested hardware component"),
                    price: Number(p.price) || 0,
                    image_url: p.imageUrl || p.image_url || "/img/electronics-workbench.jpg",
                    slug: p.slug || p.id
                  }))
                : [];
            %>

            <!-- Component Highlight Showcase Carousel -->
            <% if (spotlights.length > 0) { %>
            <div class="spotlight-showcase" id="spotlightShowcase" data-ui="spotlight">
              <div class="spotlight-showcase__header">
                <div class="spotlight-showcase__status">
                  <span class="spotlight-showcase__live-dot" aria-hidden="true"></span>
                  <span class="spotlight-showcase__header-title">Workbench Spotlight</span>
                </div>
                <div class="spotlight-showcase__nav" style="<%= spotlights.length <= 1 ? 'display: none;' : '' %>">
                  <button type="button" class="spotlight-nav-btn spotlight-nav-btn--prev" id="spotlightPrevBtn" aria-label="Previous component">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="15 18 9 12 15 6" />
                    </svg>
                  </button>
                  <span class="spotlight-showcase__counter" id="spotlightCounter">1 / <%= spotlights.length %></span>
                  <button type="button" class="spotlight-nav-btn spotlight-nav-btn--next" id="spotlightNextBtn" aria-label="Next component">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6" />
                    </svg>
                  </button>
                </div>
              </div>

              <div class="spotlight-slider-wrapper">
                <div class="spotlight-track" id="spotlightTrack">
                  <% spotlights.forEach(function(item, idx) { %>
                    <article class="spotlight-slide <%= idx === 0 ? 'is-active' : '' %>" data-slide-index="<%= idx %>" aria-hidden="<%= idx === 0 ? 'false' : 'true' %>">
                      <div class="spotlight-slide__media">
                        <img src="<%= item.image_url %>" alt="<%= item.name %>" class="spotlight-slide__img" loading="<%= idx === 0 ? 'eager' : 'lazy' %>" />
                        <div class="spotlight-slide__badges">
                          <span class="spotlight-badge spotlight-badge--cat"><%= item.category %></span>
                          <span class="spotlight-badge spotlight-badge--diff spotlight-badge--<%= (item.difficulty || 'beginner').toLowerCase().replace(/\s/g, '-') %>"><%= item.difficulty || 'Beginner' %></span>
                        </div>
                      </div>
                      <div class="spotlight-slide__body">
                        <h3 class="spotlight-slide__title"><%= item.name %></h3>
                        <p class="spotlight-slide__spec"><%= item.spec %></p>
                        <div class="spotlight-slide__footer">
                          <div class="spotlight-slide__pricing">
                            <span class="spotlight-slide__price-label">Unit price</span>
                            <span class="spotlight-slide__price">₱<%= item.price.toFixed(2) %></span>
                          </div>
                          <a href="/shop?category=<%= encodeURIComponent(item.category) %>" class="spotlight-slide__action">
                            <span>Inspect part</span>
                            <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <line x1="5" y1="12" x2="19" y2="12" />
                              <polyline points="12 5 19 12 12 19" />
                            </svg>
                          </a>
                        </div>
                      </div>
                    </article>
                  <% }); %>
                </div>
              </div>

              <div class="spotlight-showcase__footer" style="<%= spotlights.length <= 1 ? 'display: none;' : '' %>">
                <div class="spotlight-indicators" id="spotlightIndicators">
                  <% spotlights.forEach(function(_, idx) { %>
                    <button type="button" class="spotlight-dot <%= idx === 0 ? 'is-active' : '' %>" data-index="<%= idx %>" aria-label="Go to component <%= idx + 1 %>"></button>
                  <% }); %>
                </div>
                <div class="spotlight-progress" aria-hidden="true">
                  <div class="spotlight-progress__bar" id="spotlightProgressBar"></div>
                </div>
              </div>
            </div>
            <% } else { %>
            <div class="spotlight-showcase spotlight-showcase--empty" id="spotlightShowcase" style="display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 320px; text-align: center; padding: 2rem;">
              <div class="spotlight-empty-state" style="display: flex; flex-direction: column; align-items: center; gap: 0.75rem;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: hsl(var(--muted-foreground)); opacity: 0.6;">
                  <rect width="18" height="18" x="3" y="3" rx="2"/>
                  <path d="M7 8h10"/>
                  <path d="M7 12h10"/>
                  <path d="M7 16h6"/>
                </svg>
                <h4 style="margin: 0; font-size: 1.1rem; font-weight: 600; color: hsl(var(--foreground));">Catalog Updating</h4>
                <p style="margin: 0; font-size: 0.875rem; color: hsl(var(--muted-foreground)); max-width: 260px;">Available hardware components from the database will appear here.</p>
                <a href="/shop" class="btn btn--outline" style="margin-top: 0.5rem; font-size: 0.825rem; padding: 0.4rem 1rem;">Browse Catalog</a>
              </div>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <!-- ── VALUE PROPS ── -->
    <section class="value-props">
      <div class="container value-props__inner">
        <div class="value-bar">
          <div class="value-bar__grid">
            <% const valueProps=[ 
              { title: "Tested before shipping", text: "Every unit is bench-checked before dispatch — no dead boards, no dud buzzers." },
              { title: "Single units, no minimums", text: "Buy exactly one buzzer or twenty sensors. Parts sold individually, always." },
              { title: "Fast 24-hour dispatch", text: "In-stock parts ship within 24 hours, packed anti-static for safe bench transit." },
              { title: "Pinouts & datasheets", text: "Direct pinouts and verified datasheets for every module so you wire with confidence." }
            ]; %>
            <% valueProps.forEach(function(f, i) { %>
              <div class="value-bar__item value-card" data-step="<%= i %>">
                <div class="value-bar__header">
                  <div class="value-bar__icon">
                    <% if (i === 0) { %>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        <polyline points="9 12 11 14 15 10" />
                      </svg>
                    <% } else if (i === 1) { %>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <line x1="19" y1="8" x2="19" y2="14" />
                        <line x1="22" y1="11" x2="16" y2="11" />
                      </svg>
                    <% } else if (i === 2) { %>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13" />
                        <polygon points="16 8 20 8 23 11 23 16 16 16 8" />
                        <circle cx="5.5" cy="18.5" r="2.5" />
                        <circle cx="18.5" cy="18.5" r="2.5" />
                      </svg>
                    <% } else { %>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="16" y1="13" x2="8" y2="13" />
                        <line x1="16" y1="17" x2="8" y2="17" />
                        <polyline points="10 9 9 9 8 9" />
                      </svg>
                    <% } %>
                  </div>
                </div>
                <h3 class="value-bar__title"><%= f.title %></h3>
                <p class="value-bar__desc"><%= f.text %></p>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FEATURED PARTS ── -->
    <section class="featured">
      <div class="container">
        <div class="featured__header">
          <div>
            <h2>Featured parts</h2>
            <p class="subtitle">The components our community keeps coming back for.</p>
          </div>
          <a href="/shop" class="featured__view-all">
            View all
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>

        <% if (locals.loading) { %>
          <div class="product-grid">
            <% for (let i=0; i < 4; i++) { %>
              <div class="skeleton"></div>
              <% } %>
          </div>
          <% } else if (!featured || featured.length===0) { %>
            <div class="empty-state" style="padding: 3rem 1.5rem; text-align: center; border: 1px dashed hsl(var(--border)); border-radius: 0.75rem; background: hsl(var(--card) / 0.4); margin: 1.5rem 0;">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 0.75rem auto; color: hsl(var(--muted-foreground)); opacity: 0.7;">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
                <line x1="8" y1="11" x2="14" y2="11" />
              </svg>
              <h3 style="font-size: 1.1rem; font-weight: 600; color: hsl(var(--foreground)); margin-bottom: 0.35rem;">No featured items available yet</h3>
              <p style="font-size: 0.875rem; color: hsl(var(--muted-foreground)); margin-bottom: 1.25rem;">Items added from the admin console will appear here once published.</p>
              <a href="/shop" class="btn btn--outline" style="display: inline-flex; font-size: 0.85rem; padding: 0.45rem 1.2rem;">Browse Shop Catalog</a>
            </div>
          <% } else { %>
              <div class="product-grid">
                <% featured.forEach(function(p) { %>
                  <div class="product-card" data-slug="<%= p.slug %>">
                    <div class="product-card__img-wrap">
                      <div class="product-card__badges">
                        <span class="product-card__cat-badge">
                          <%= p.category %>
                        </span>
                        <% if (p.difficulty) { %>
                          <span
                            class="product-card__diff-badge product-card__diff-badge--<%= p.difficulty.toLowerCase().replace(/\s/g, '-') %>">
                            <%= p.difficulty %>
                          </span>
                          <% } %>
                      </div>
                      <img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy" />
                    </div>
                    <div class="product-card__body">
                      <h3 class="product-card__name">
                        <%= p.name %>
                      </h3>
                      <p class="product-card__tagline">
                        <%= p.tagline %>
                      </p>
                      <div class="product-card__meta">
                        <span class="product-card__rating">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true" style="color: #f59e0b; vertical-align: -1px; margin-right: 3px;">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                          </svg><%= p.rating ? p.rating.toFixed(1) : '—' %>
                          <span class="product-card__review-count">(<%= p.review_count || 0 %>)</span>
                        </span>
                        <% const currentStock = Number(p.stock !== undefined ? p.stock : (p.stockQuantity !== undefined ? p.stockQuantity : 0)); %>
                        <% if (currentStock <= 0) { %>
                          <span class="product-card__stock-tag product-card__stock-tag--out">
                            <span class="stock-dot stock-dot--out"></span>
                            Out of stock
                          </span>
                        <% } else if (currentStock <= 5) { %>
                          <span class="product-card__stock-tag product-card__stock-tag--low">
                            <span class="stock-dot stock-dot--low"></span>
                            Only <%= currentStock %> left
                          </span>
                        <% } else { %>
                          <span class="product-card__stock-tag product-card__stock-tag--in">
                            <span class="stock-dot stock-dot--in"></span>
                            <%= currentStock %> left in stock
                          </span>
                        <% } %>
                      </div>
                      <div class="product-card__footer">
                        <span class="product-card__price">₱<%= p.price.toFixed(2) %></span>
                        <% if (currentStock > 0) { %>
                          <button type="button" class="product-card__add-btn js-add-to-cart"
                            data-id="<%= p.id %>"
                            data-name="<%= (p.name || '').replace(/["']/g, '') %>"
                            data-price="<%= p.price %>"
                            data-img="<%= p.image_url %>"
                            data-stock="<%= currentStock %>"
                            data-max="<%= currentStock %>"
                            aria-label="Add to cart">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <line x1="12" y1="5" x2="12" y2="19" />
                              <line x1="5" y1="12" x2="19" y2="12" />
                            </svg>
                          </button>
                        <% } else { %>
                          <button type="button" class="product-card__add-btn is-sold-out" disabled aria-label="Sold out" title="Out of stock">
                            <span class="sold-out-text">Sold out</span>
                          </button>
                        <% } %>
                      </div>
                    </div>
                  </div>
                  <% }); %>
              </div>
              <% } %>
      </div>
    </section>

    <!-- ── SHOP BY DOMAIN ── -->
    <section id="categories" class="categories">
      <div class="container categories__inner">
        <h2>Shop by domain</h2>
        <p class="subtitle">Parts grouped by the engineering discipline they serve.</p>
        <div class="categories__grid">
          <% const categories=[ { name: "Microcontrollers" , desc: "ESP32, Arduino, STM32 boards" }, {
            name: "Sensors & Modules" , desc: "Ultrasonic, DHT11, PIR sensors" }, { name: "Buzzers & Audio" ,
            desc: "Piezo buzzers & speakers" }, { name: "Motors & Actuators" , desc: "Servo & DC motors" }, {
