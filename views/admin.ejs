<!DOCTYPE html>
<html lang="en" data-auth="true">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin console — LabKit Market</title>
  <link rel="stylesheet" href="/css/dashboard.css" />
  <link rel="stylesheet" href="/css/cart.css" />
  <link rel="stylesheet" href="/css/admin.css" />
  <link rel="stylesheet" href="/css/navbar-search.css" />
  <script src="/js/theme.js"></script>
</head>
<body>
  <header class="navbar">
    <div class="container navbar__inner">
      <a href="/" class="navbar__brand">
        <span class="navbar__logo-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9"/>
            <path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/>
          </svg>
        </span>
        <span class="navbar__wordmark">LabKit</span><span class="navbar__sub">/MARKET</span>
      </a>
      <nav class="navbar__nav">
        <a href="/" class="navbar__link">Home</a><a href="/shop" class="navbar__link">Shop</a>
        <a href="/about" class="navbar__link">About Us</a><a href="/admin" class="navbar__link navbar__link--active">Admin</a>
      </nav>
      <div class="navbar__actions">
        <div class="navbar-search">
        <button type="button" class="navbar__icon-btn navbar-search__toggle" aria-label="Search" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <form class="navbar-search__form" action="/shop" method="get" role="search">
          <input class="navbar-search__input" name="q" type="search" placeholder="Search products..." aria-label="Search products" />
        </form>
        </div>
        <button type="button" class="navbar__icon-btn navbar__cart" id="openCartBtn" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <span class="navbar__cart-badge" id="cartBadge" style="display:none;">0</span>
        </button>
        <div class="profile-dropdown-wrapper">
          <button class="navbar__avatar-btn" id="avatarBtn" aria-label="User menu" aria-expanded="false">
            <span class="navbar__avatar"><%= ((locals.currentUser && locals.currentUser.firstName) || "A").charAt(0).toUpperCase() %></span>
            <svg class="navbar__avatar-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="profile-dropdown" id="profileDropdown">
            <div class="profile-dropdown__header"><p class="profile-dropdown__name"><%= (locals.currentUser && locals.currentUser.firstName) || "Admin" %> <%= (locals.currentUser && locals.currentUser.lastName) || "" %></p><p class="profile-dropdown__email"><%= (locals.currentUser && locals.currentUser.email) || "" %></p></div>
            <div class="profile-dropdown__divider"></div>
            <a href="/settings" class="profile-dropdown__item"><span>⚙</span><span>Settings</span></a>
            <a href="/logout" class="profile-dropdown__item"><span>↪</span><span>Sign out</span></a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="admin-page">
    <section class="console-header">
      <div class="console-title">
        <span class="console-icon">◈</span>
        <div><h1>Admin console</h1><p>Manage bundles and user accounts.</p></div>
      </div>
      <span class="console-label">◉ &nbsp; Inventory console</span>
    </section>

    <% if (error) { %><div class="admin-alert"><%= error %></div><% } %>

    <div class="tabs" role="tablist">
      <button type="button" class="tab is-active" data-tab="products">Products</button>
      <button type="button" class="tab" data-tab="accounts">Accounts</button>
    </div>

    <section class="tab-panel is-active" data-panel="products">
      <section class="admin-card bundle-list-card">
        <div class="section-heading">
          <div class="section-heading__title"><span class="section-icon">◈</span><div><h2>Manage bundles</h2><p>Remove items from the shop.</p></div></div>
          <button type="button" class="outline-button" id="focusBundleForm">＋ &nbsp;Add new</button>
        </div>
        <% if (!kits.length) { %><p class="empty-state">No bundles yet — add your first one below.</p><% } %>
        <% kits.forEach(kit => { %>
          <div class="bundle-row"><div><strong><%= kit.name %></strong><span><%= kit.category %> · ₱<%= kit.price.toFixed(2) %> · <%= kit.stock_quantity %> in stock</span></div><strong>Limit: <%= kit.maxPurchaseQuantity %></strong></div>
        <% }) %>
      </section>

      <form class="bundle-editor" id="bundleForm" method="post" action="/admin/bundles">
        <div class="editor-main">
          <section class="admin-card">
            <div class="section-heading"><div class="section-heading__title"><span class="section-icon">▣</span><div><h2>Basics</h2><p>Identity, imagery, and category.</p></div></div></div>
            <div class="form-grid">
              <label>Name *<input name="name" id="bundleName" required value="<%= formData.name || '' %>" /></label>
              <label>Slug<input id="bundleSlug" placeholder="auto-generated if blank" readonly /></label>
              <label>Tagline *<input name="tagline" id="bundleTagline" required value="<%= formData.tagline || '' %>" /></label>
              <label>Image URL *<input name="image_url" id="bundleImage" type="url" required placeholder="https://..." value="<%= formData.image_url || '' %>" /></label>
              <label>Category *
                <select name="category"><option>IoT & WiFi</option><option>IoT Kits</option><option>Sensors & Modules</option><option>Microcontrollers</option></select>
              </label>
              <label>Difficulty *
                <select name="difficulty"><option>Beginner</option><option>Intermediate</option><option>Advanced</option><option>All levels</option></select>
              </label>
            </div>
            <label>Description *<textarea name="description" id="bundleDescription" required><%= formData.description || '' %></textarea></label>
          </section>

          <section class="admin-card">
            <div class="section-heading"><div class="section-heading__title"><span class="section-icon">◇</span><div><h2>Pricing &amp; inventory</h2><p>Set the price and stock level.</p></div></div></div>
            <div class="form-grid form-grid--three">
              <label>Price (PHP) *<input name="price" id="bundlePrice" type="number" min="0" step="0.01" required value="<%= formData.price || '' %>" /></label>
              <label>Compare-at (PHP)<input name="compare_at_price" type="number" min="0" step="0.01" /></label>
              <label>Stock<input name="stock_quantity" type="number" min="0" step="1" required value="<%= formData.stock_quantity || 25 %>" /></label>
              <label>Max per order<input name="maxPurchaseQuantity" type="number" min="1" step="1" required value="<%= formData.maxPurchaseQuantity || 10 %>" /></label>
            </div>
            <label class="feature-toggle"><span>☆ &nbsp; Feature on the home page</span><input type="checkbox" /></label>
          </section>

          <section class="admin-card">
            <div class="section-heading"><div class="section-heading__title"><span class="section-icon">♧</span><div><h2>Contents</h2><p>Components and features, one per line.</p></div></div></div>
            <div class="form-grid">
              <label>Components (one per line) *<textarea name="components" required placeholder="ESP32 board | 1 | WiFi + Bluetooth"><%= formData.components || '' %></textarea></label>
              <label>Features (one per line)<textarea name="features" placeholder="Pinout diagrams&#10;Sample code snippets"></textarea></label>
            </div>
          </section>
        </div>

        <aside class="editor-side">
          <div class="preview-label">LIVE PREVIEW</div>
          <article class="preview-card">
            <div class="preview-image" id="previewImage"><span>▧</span></div>
            <div class="preview-body"><div><b>Beginner</b> <small>IoT &amp; WiFi</small></div><h3 id="previewName">Bundle name</h3><p id="previewTagline">A short, punchy tagline appears here.</p><strong id="previewPrice">₱0.00</strong></div>
          </article>
          <div class="side-actions"><button class="primary-button" type="submit">＋ &nbsp; Add bundle</button><a href="/admin" class="cancel-button">Cancel</a></div>
        </aside>
      </form>
    </section>

    <section class="tab-panel" data-panel="accounts">
      <section class="admin-card accounts-card">
        <div class="section-heading"><div class="section-heading__title"><span class="section-icon">♧</span><div><h2>Accounts</h2><p>Remove app accounts. You can't remove your own.</p></div></div></div>
        <% users.forEach(user => { %>
          <div class="account-row">
            <div><strong><%= user.firstName %> <%= user.lastName %></strong><span><%= user.email %> · @<%= user.username %> · <%= user.role %></span></div>
            <% const currentUserId = currentUser ? String(currentUser.id || currentUser._id || '') : ''; %>
            <% if (String(user._id) !== currentUserId) { %><form method="post" action="/admin/accounts/<%= user._id %>/delete"><button class="remove-button" type="submit">Remove</button></form><% } else { %><span class="you-label">You</span><% } %>
          </div>
        <% }) %>
      </section>
      <section class="admin-card password-card">
        <div class="section-heading"><div class="section-heading__title"><span class="section-icon">⚿</span><div><h2>Change your password</h2><p>Changes the password for <%= (currentUser && currentUser.email) || 'your account' %>.</p></div></div></div>
        <form class="password-form" id="adminPasswordForm">
          <input name="currentPassword" type="password" placeholder="Current password" required />
          <input name="newPassword" type="password" placeholder="New password" required />
          <input name="confirmPassword" type="password" placeholder="Confirm new password" required />
          <button class="primary-button" type="submit">⚿ &nbsp; Update password</button>
        </form>
      </section>
    </section>
  </main>

  <footer class="admin-footer"><strong>⚙ &nbsp; LabKit Market</strong><p>Project-ready hardware bundles for engineering students and hobbyists.</p></footer>
  <script src="/js/cart.js"></script>
  <script src="/js/navbar-search.js"></script>
  <script src="/js/admin.js"></script>
</body>
</html>
