<!DOCTYPE html>
<html lang="en" data-auth="<%= locals.currentUser ? 'true' : 'false' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout — LabKit Market</title>
  <link rel="stylesheet" href="/css/checkout.css" />
  <link rel="stylesheet" href="/css/cart.css" />
  <link rel="stylesheet" href="/css/navbar-search.css" />
  <script src="/js/theme.js"></script>
  <script src="/js/page-transitions.js"></script>
</head>
<body>

  <header class="navbar">
    <div class="container navbar__inner">
      <a href="/" class="navbar__brand">
        <span class="navbar__logo-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="16" height="16" x="4" y="4" rx="2"/>
            <rect width="6" height="6" x="9" y="9"/>
            <path d="M15 2v2"/><path d="M15 20v2"/>
            <path d="M2 15h2"/><path d="M2 9h2"/>
            <path d="M20 15h2"/><path d="M20 9h2"/>
            <path d="M9 2v2"/><path d="M9 20v2"/>
          </svg>
        </span>
        <span class="navbar__wordmark">LabKit</span>
        <span class="navbar__sub">/MARKET</span>
      </a>

      <nav class="navbar__nav">
        <a href="/" class="navbar__link">Home</a>
        <a href="/shop" class="navbar__link">Shop</a>
        <a href="/about" class="navbar__link">About Us</a>
        <% if (locals.currentUser && (locals.currentUser.role === 'admin' || locals.userRole === 'admin')) { %>
        <a href="/admin" class="navbar__link">Admin</a>
        <% } %>
      </nav>

      <div class="navbar__actions">
        <div class="navbar-search">
        <button type="button" class="navbar__icon-btn navbar-search__toggle" aria-label="Search" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
        <form class="navbar-search__form" action="/shop" method="get" role="search">
          <input class="navbar-search__input" name="q" type="search" placeholder="Search products..." aria-label="Search products" />
        </form>
        </div>
        <button type="button" class="navbar__icon-btn navbar__cart" id="openCartBtn" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span class="navbar__cart-badge" id="cartBadge">1</span>
        </button>

        <% if (locals.currentUser) { %>
        <div class="profile-dropdown-wrapper">
          <button class="navbar__avatar-btn" id="avatarBtn" aria-label="User menu" aria-expanded="false">
            <% if (locals.currentUser.avatar) { %>
              <img src="<%= locals.currentUser.avatar %>" alt="User avatar" class="navbar__avatar" style="object-fit: cover; border-radius: 9999px;" />
            <% } else { %>
              <span class="navbar__avatar"><%= locals.currentUser.firstName ? locals.currentUser.firstName.charAt(0).toUpperCase() : 'U' %></span>
            <% } %>
            <svg class="navbar__avatar-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>

          <div class="profile-dropdown" id="profileDropdown">
            <div class="profile-dropdown__header">
              <p class="profile-dropdown__name"><%= locals.currentUser.firstName %> <%= locals.currentUser.lastName %></p>
              <p class="profile-dropdown__email"><%= locals.currentUser.email %></p>
            </div>
            <div class="profile-dropdown__divider"></div>
            <% if (locals.currentUser && (locals.currentUser.role === 'admin' || locals.userRole === 'admin')) { %>
            <a href="/admin" class="profile-dropdown__item profile-dropdown__item--admin">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span>Admin Dashboard</span>
            </a>
            <% } %>
            <a href="/settings" class="profile-dropdown__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
              </svg>
              <span>Settings</span>
            </a>
            <a href="/logout" class="profile-dropdown__item" onclick="localStorage.removeItem('userEmail'); localStorage.removeItem('userName'); localStorage.removeItem('theme'); document.documentElement.classList.remove('dark');">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
              <span>Sign out</span>
            </a>
          </div>
        </div>
        <% } else { %>
        <a href="/login" style="display: inline-flex; align-items: center; justify-content: center; padding: 0.45rem 1rem; font-size: 0.875rem; font-weight: 500; border-radius: 0.375rem; background: hsl(var(--primary)); color: #ffffff; text-decoration: none; transition: opacity 0.15s ease;">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="checkout-page container page-main">
    <div class="checkout-container">
      <a href="/shop" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"/>
          <polyline points="12 19 5 12 12 5"/>
        </svg>
        <span>Continue shopping</span>
      </a>

      <h1 class="checkout-title">Checkout</h1>
      <div class="checkout-steps" aria-label="Checkout progress">
        <span class="checkout-step is-active" data-step-indicator="1"><b>1</b> Billing information</span>
        <span class="checkout-step" data-step-indicator="2"><b>2</b> Payment method</span>
        <span class="checkout-step" data-step-indicator="3"><b>3</b> Review</span>
      </div>

      <div class="checkout-grid">
        <div class="checkout-form-column">
          <form id="checkoutForm">
            
            <section class="checkout-section checkout-step-panel is-active" data-step-panel="1">
              <h2 class="checkout-section-title">Billing information</h2>

              <div class="form-group">
                <label for="country">Country/region</label>
                <div class="checkout-custom-select" data-select-id="country">
                  <select id="country" class="form-input form-select">
                    <option value="Philippines" selected>Philippines</option>
                  </select>
                  <button type="button" class="checkout-select-trigger" aria-haspopup="listbox" aria-expanded="false">
                    <span>Philippines</span><i aria-hidden="true"></i>
                  </button>
                  <div class="checkout-select-options" role="listbox" hidden></div>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="firstName">First name *</label>
                  <input type="text" id="firstName" class="form-input" required />
                </div>
                <div class="form-group">
                  <label for="lastName">Last name *</label>
                  <input type="text" id="lastName" class="form-input" required />
                </div>
              </div>

              <div class="form-group">
                <label for="company">Company <span class="form-optional">(optional)</span></label>
                <input type="text" id="company" class="form-input" />
              </div>

              <div class="form-group">
                <label for="address">Address *</label>
                <input type="text" id="address" class="form-input" required />
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="province">Province *</label>
                  <div class="checkout-custom-select" data-select-id="province">
                  <select id="province" class="form-input form-select" required>
                    <option value="">Select Province</option>
                    <optgroup label="Luzon (38 Provinces)">
                      <option>Abra</option><option>Albay</option><option>Apayao</option><option>Aurora</option>
                      <option>Bataan</option><option>Batanes</option><option>Batangas</option><option>Benguet</option>
                      <option>Bulacan</option><option>Cagayan</option><option>Camarines Norte</option><option>Camarines Sur</option>
                      <option>Catanduanes</option><option>Cavite</option><option>Ifugao</option><option>Ilocos Norte</option>
                      <option>Ilocos Sur</option><option>Isabela</option><option>Kalinga</option><option>La Union</option>
                      <option>Laguna</option><option>Marinduque</option><option>Masbate</option><option>Mountain Province</option>
                      <option>Nueva Ecija</option><option>Nueva Vizcaya</option><option>Occidental Mindoro</option>
                      <option>Oriental Mindoro</option><option>Palawan</option><option>Pampanga</option><option>Pangasinan</option>
                      <option>Quezon</option><option>Quirino</option><option>Rizal</option><option>Romblon</option>
                      <option>Sorsogon</option><option>Tarlac</option><option>Zambales</option>
                    </optgroup>
                    <optgroup label="Visayas (16 Provinces)">
                      <option>Aklan</option><option>Antique</option><option>Biliran</option><option>Bohol</option>
                      <option>Capiz</option><option>Cebu</option><option>Eastern Samar</option><option>Guimaras</option>
                      <option>Iloilo</option><option>Leyte</option><option>Negros Occidental</option><option>Negros Oriental</option>
                      <option>Northern Samar</option><option>Samar (formerly Western Samar)</option><option>Siquijor</option>
                      <option>Southern Leyte</option>
                    </optgroup>
                    <optgroup label="Mindanao (28 Provinces)">
                      <option>Agusan del Norte</option><option>Agusan del Sur</option><option>Basilan</option><option>Bukidnon</option>
                      <option>Camiguin</option><option>Cotabato (formerly North Cotabato)</option>
                      <option>Davao de Oro (formerly Compostela Valley)</option><option>Davao del Norte</option>
                      <option>Davao del Sur</option><option>Davao Occidental</option><option>Davao Oriental</option>
                      <option>Dinagat Islands</option><option>Lanao del Norte</option><option>Lanao del Sur</option>
                      <option>Maguindanao del Norte</option><option>Maguindanao del Sur</option><option>Misamis Occidental</option>
                      <option>Misamis Oriental</option><option>Sarangani</option><option>South Cotabato</option>
                      <option>Sultan Kudarat</option><option>Sulu</option><option>Surigao del Norte</option>
                      <option>Surigao del Sur</option><option>Tawi-Tawi</option><option>Zamboanga del Norte</option>
                      <option>Zamboanga del Sur</option><option>Zamboanga Sibugay</option>
                    </optgroup>
                    <optgroup label="National Capital Region">
                      <option>Metro Manila (NCR)</option>
                    </optgroup>
                  </select>
                  <button type="button" class="checkout-select-trigger" aria-haspopup="listbox" aria-expanded="false">
                    <span>Select Province</span><i aria-hidden="true"></i>
                  </button>
                  <div class="checkout-select-options" role="listbox" hidden></div>
                  </div>
                </div>
                <div class="form-group">
                  <label for="city">City / Municipality *</label>
                  <div class="checkout-custom-select is-disabled" data-select-id="city">
                    <select id="city" class="form-input form-select" required disabled>
                      <option value="">Select City / Municipality</option>
                    </select>
                    <button type="button" class="checkout-select-trigger" aria-haspopup="listbox" aria-expanded="false" disabled>
                      <span>Select City / Municipality</span><i aria-hidden="true"></i>
                    </button>
                    <div class="checkout-select-options" role="listbox" hidden></div>
                  </div>
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="barangay">Barangay *</label>
                  <input type="text" id="barangay" class="form-input" required />
                </div>
                <div class="form-group">
                  <label for="zipCode">Postal code</label>
                  <input type="text" id="zipCode" class="form-input" inputmode="numeric" />
                </div>
              </div>

              <div class="form-group">
                <label for="phone">Phone *</label>
                <input type="tel" id="phone" class="form-input" required />
              </div>

              <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" class="form-input" required />
                <span class="form-helper">Digital assets and order updates are sent here</span>
              </div>
              <button type="button" class="checkout-next-btn" data-next-step="2">Continue to payment</button>
            </section>

            <section class="checkout-section checkout-step-panel" data-step-panel="2" hidden>
              <h2 class="checkout-section-title">Payment method</h2>

              <div class="payment-card">
                <div class="payment-card__demo-note">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  <span>Secure checkout — this is a demo store. No real card is charged.</span>
                </div>

                <div class="payment-options" role="radiogroup" aria-label="Payment method">
                  <label class="payment-option">
                    <input type="radio" name="paymentMethod" value="gcash" required />
                    <span class="payment-option__icon" aria-hidden="true">
                      <img src="/img/Gcash.png" alt="" />
                    </span>
                    <span class="payment-option__details"><strong>GCash</strong><small>Pay using your GCash wallet</small></span>
                  </label>
                  <label class="payment-option">
                    <input type="radio" name="paymentMethod" value="card" />
                    <span class="payment-option__icon payment-option__icon--cards" aria-hidden="true">
                      <img src="/img/Card.png" alt="" />
                    </span>
                    <span class="payment-option__details"><strong>Card</strong><small>Visa, Mastercard, or debit card</small></span>
                  </label>
                  <label class="payment-option">
                    <input type="radio" name="paymentMethod" value="cod" />
                    <span class="payment-option__icon payment-option__icon--cod" aria-hidden="true">
                      <img src="/img/COD.png" alt="" />
                    </span>
                    <span class="payment-option__details"><strong>Cash on delivery</strong><small>Pay when your order arrives</small></span>
                  </label>
                </div>

                <div id="cardDetails" class="card-details" hidden>
                  <div class="form-group">
                    <label for="cardNumber">Card number *</label>
                    <input type="text" id="cardNumber" class="form-input" placeholder="4242 4242 4242 4242" inputmode="numeric" />
                  </div>
                  <div class="form-row">
                    <div class="form-group">
                      <label for="cardExpiry">Expiry date *</label>
                      <input type="text" id="cardExpiry" class="form-input" placeholder="MM / YY" />
                    </div>
                    <div class="form-group">
                      <label for="cardCvc">CVC / CVV *</label>
                      <input type="text" id="cardCvc" class="form-input" placeholder="123" inputmode="numeric" />
                    </div>
                  </div>
                </div>
                <div id="gcashDetails" class="card-details" hidden>
                  <div class="form-group">
                    <label for="gcashNumber">GCash number *</label>
                    <input type="tel" id="gcashNumber" class="form-input" placeholder="09XX XXX XXXX" inputmode="tel" autocomplete="tel" pattern="(?:09|\+639)[0-9]{2}\s?[0-9]{3}\s?[0-9]{4}" title="Enter a valid Philippine mobile number, such as 09171234567 or +639171234567" />
                    <small class="form-help">Enter the mobile number registered to your GCash wallet.</small>
                  </div>
                </div>
              </div>
              <div class="checkout-step-actions">
                <button type="button" class="checkout-back-btn" data-prev-step="1">Back</button>
                <button type="button" class="checkout-next-btn" data-next-step="3">Review order</button>
              </div>
            </section>

            <section class="checkout-section checkout-step-panel" data-step-panel="3" hidden>
              <h2 class="checkout-section-title">Review your order</h2>
              <div class="checkout-review-card" id="reviewDetails"></div>
              <div class="checkout-step-actions">
                <button type="button" class="checkout-back-btn" data-prev-step="2">Back</button>
                <button type="submit" class="checkout-confirm-btn" id="checkoutConfirmBtn">Confirm checkout</button>
              </div>
            </section>
          </form>
        </div>

        <aside class="checkout-sidebar">
          <div class="order-summary-card">
            <h2 class="order-summary-title">Order summary</h2>

            <div class="order-summary-items" id="summaryItemsList"></div>

            <div class="order-summary-totals">
              <div class="summary-line">
                <span>Subtotal</span>
                <span id="subtotalAmount">₱24.00</span>
              </div>
              <div class="summary-line">
                <span>Shipping</span>
                <span id="shippingAmount">₱6.50</span>
              </div>
              <div class="summary-line summary-line--total">
                <span>Total</span>
                <span id="totalAmount">₱30.50</span>
              </div>
            </div>

            <div class="unlocks-vault-card">
              <div class="unlocks-vault-header">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
                <h3>Unlocks instantly</h3>
              </div>
              <p class="unlocks-vault-desc">
                Every order includes verified hardware documentation:
              </p>
              <ul class="unlocks-vault-list">
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="18" x="3" y="3" rx="2"/>
                    <path d="M7 8h10"/>
                    <path d="M7 12h10"/>
                    <path d="M7 16h6"/>
                  </svg>
                  <span>Pinout diagrams</span>
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                  </svg>
                  <span>Voltage & logic ratings</span>
                </li>
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"/>
                    <polyline points="8 6 2 12 8 18"/>
                  </svg>
                  <span>Sample code snippets</span>
                </li>
              </ul>
            </div>

          </div>
        </aside>
      </div>
    </div>
  </main>

  <div class="payment-success-backdrop" id="paymentSuccessBackdrop" aria-hidden="true"></div>
  <section class="payment-toast" id="paymentToast" role="status" aria-live="polite" aria-hidden="true">
    <div class="payment-toast__icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m5 12 4 4L19 6"/>
      </svg>
    </div>
    <div class="payment-toast__content">
      <h2>Payment Successful!</h2>
      <p>Your receipt or invoice will be sent to your email shortly.</p>
      <p class="payment-toast__order" id="paymentToastOrder"></p>
      <a href="/" class="payment-toast__button">Go back to home page</a>
    </div>
  </section>

  <div class="cart-drawer-backdrop" id="cartBackdrop"></div>
  <aside class="cart-drawer" id="cartDrawer" aria-label="Shopping Cart">
    <div class="cart-drawer__header">
      <div class="cart-drawer__title-wrap">
        <svg class="cart-drawer__bag-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
          <path d="M3 6h18"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <h2>Your Cart</h2>
      </div>
      <button type="button" class="cart-drawer__close" id="closeCartBtn" aria-label="Close cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="cart-drawer__body" id="cartDrawerBody"></div>
    <div class="cart-drawer__footer" id="cartDrawerFooter">
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <strong id="cartSubtotal">₱0.00</strong>
      </div>
      <div class="cart-drawer__notice">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2"/>
          <path d="M7 8h10"/>
          <path d="M7 12h10"/>
          <path d="M7 16h6"/>
        </svg>
        <span>Every part ships with datasheets and pinout diagrams.</span>
      </div>
      <a href="/checkout" class="btn-checkout" id="checkoutBtn">
        Checkout · <span id="checkoutTotal">₱0.00</span>
      </a>
    </div>
  </aside>

  <footer class="footer">
    <div class="container footer__inner">
      <div class="footer__top">
        <div class="footer__brand-block">
          <div class="footer__logo">
            <span class="navbar__logo-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="16" height="16" x="4" y="4" rx="2"/>
                <rect width="6" height="6" x="9" y="9"/>
                <path d="M15 2v2"/><path d="M15 20v2"/>
                <path d="M2 15h2"/><path d="M2 9h2"/>
                <path d="M20 15h2"/><path d="M20 9h2"/>
                <path d="M9 2v2"/><path d="M9 20v2"/>
              </svg>
            </span>
            <span class="footer__brand-text">LabKit Market</span>
          </div>
          <p class="footer__desc">
            Individual electronic components and IoT hardware for engineering students and makers. Buy single
            ESP32 boards, buzzers, sensors, and wiring &mdash; bench-checked with pinout datasheets included.
          </p>
        </div>

        <nav class="footer__links">
          <a href="/shop" class="footer__link">Shop</a>
          <a href="/about" class="footer__link">About Us</a>
          <a href="/#workbench" class="footer__link">Built for the workbench</a>
        </nav>
      </div>

      <div class="footer__bottom">
        <p>© 2026 LabKit Market — Individual parts for IoT & prototyping.</p>
      </div>
    </div>
  </footer>

  <script src="/js/cart.js"></script>
  <script src="/js/navbar-search.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const savedCart = getCart();
      const fallbackCart = [
        {
          id: "3",
          name: "7400-Series Logic Gate Breadboard Starter",
          price: 1404.00,
          qty: 1,
          img: "https://images.unsplash.com/photo-1517077304055-6e89abbf09b0?w=600"
        }
      ];

      const selectedCart = typeof getSelectedCart === "function" ? getSelectedCart() : savedCart;
      const checkoutItems = savedCart.length > 0 ? selectedCart : fallbackCart;
      const confirmButton = document.getElementById("checkoutConfirmBtn");
      if (savedCart.length > 0 && checkoutItems.length === 0 && confirmButton) {
        confirmButton.disabled = true;
        confirmButton.textContent = "Select items in your cart";
      }

      const formatCurrency = (amount) => new Intl.NumberFormat("en-PH", {
        style: "currency", currency: "PHP", minimumFractionDigits: 2
      }).format(Number(amount) || 0);
      const subtotal = checkoutItems.reduce((sum, item) => sum + item.price * item.qty, 0);
      const shipping = 380.25;
      const total = subtotal + shipping;

      const itemsListEl = document.getElementById("summaryItemsList");
      if (itemsListEl) {
        const summaryMarkup = checkoutItems.map(item => `
          <div class="order-summary-item">
            <img src="${item.img}" alt="${item.name}" class="order-summary-item__img" />
            <div class="order-summary-item__info">
              <h4 class="order-summary-item__name">${item.name}</h4>
              <span class="order-summary-item__qty">Qty ${item.qty}</span>
            </div>
            <span class="order-summary-item__price">${formatCurrency(item.price * item.qty)}</span>
          </div>
        `).join("");
        itemsListEl.innerHTML = summaryMarkup;
      }

      document.getElementById("subtotalAmount").textContent = formatCurrency(subtotal);
      document.getElementById("shippingAmount").textContent = formatCurrency(shipping);
      document.getElementById("totalAmount").textContent = formatCurrency(total);
      const showStep = (stepNumber) => {
        document.querySelectorAll("[data-step-panel]").forEach((panel) => {
          const isActive = panel.dataset.stepPanel === String(stepNumber);
          panel.hidden = !isActive;
          panel.classList.toggle("is-active", isActive);
        });
        document.querySelectorAll("[data-step-indicator]").forEach((indicator) => {
          const step = Number(indicator.dataset.stepIndicator);
          indicator.classList.toggle("is-active", step === stepNumber);
          indicator.classList.toggle("is-complete", step < stepNumber);
        });
      };

      document.querySelectorAll(".checkout-custom-select").forEach((customSelect) => {
        const nativeSelect = customSelect.querySelector("select");
        const trigger = customSelect.querySelector(".checkout-select-trigger");
        const triggerLabel = trigger.querySelector("span");
        const optionsPanel = customSelect.querySelector(".checkout-select-options");
        if (!nativeSelect || !trigger || !optionsPanel) return;

        [...nativeSelect.children].forEach((child) => {
          if (child.tagName === "OPTGROUP") {
            const groupLabel = document.createElement("div");
            groupLabel.className = "checkout-select-group";
            groupLabel.textContent = child.label;
            optionsPanel.appendChild(groupLabel);
            [...child.children].forEach((option) => addCustomOption(option));
          } else if (child.tagName === "OPTION") {
            addCustomOption(child);
          }
        });

        function addCustomOption(option) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "checkout-select-option";
          button.textContent = option.textContent;
          button.dataset.value = option.value;
          button.setAttribute("role", "option");
          button.setAttribute("aria-selected", String(option.selected));
          if (option.selected) button.classList.add("is-active");
          button.addEventListener("click", () => {
            nativeSelect.value = option.value;
            nativeSelect.dispatchEvent(new Event("change", { bubbles: true }));
            triggerLabel.textContent = option.textContent;
            optionsPanel.querySelectorAll(".checkout-select-option").forEach((item) => {
              item.classList.toggle("is-active", item === button);
              item.setAttribute("aria-selected", String(item === button));
            });
            closeCustomSelect();
          });
          optionsPanel.appendChild(button);
        }

        const closeCustomSelect = () => {
          customSelect.classList.remove("is-open");
          trigger.setAttribute("aria-expanded", "false");
          optionsPanel.hidden = true;
        };

        trigger.addEventListener("click", () => {
          const isOpen = customSelect.classList.toggle("is-open");
          trigger.setAttribute("aria-expanded", String(isOpen));
          optionsPanel.hidden = !isOpen;
        });

        nativeSelect.addEventListener("change", () => {
          const selected = nativeSelect.options[nativeSelect.selectedIndex];
          if (selected) triggerLabel.textContent = selected.textContent;
        });

        document.addEventListener("click", (event) => {
          if (!customSelect.contains(event.target)) closeCustomSelect();
        });
      });

      const provinceSelect = document.getElementById("province");
      const citySelect = document.getElementById("city");
      const cityCustomSelect = document.querySelector('[data-select-id="city"]');
      const cityTrigger = cityCustomSelect?.querySelector(".checkout-select-trigger");
      const cityTriggerLabel = cityTrigger?.querySelector("span");
      const cityOptionsPanel = cityCustomSelect?.querySelector(".checkout-select-options");
      let localityDataPromise;
      let localityRequestId = 0;
      const provinceAliases = {
        "Samar (formerly Western Samar)": "Samar",
        "Cotabato (formerly North Cotabato)": "Cotabato",
        "Davao de Oro (formerly Compostela Valley)": "Davao de Oro"
      };

      const loadLocalities = () => {
        if (!localityDataPromise) {
          localityDataPromise = fetch("/data/philippine-localities.json").then((response) => {
            if (!response.ok) throw new Error(`PSGC request failed with status ${response.status}`);
            return response.json();
          });
        }
        return localityDataPromise;
      };

      const setCityOptions = (provinceName, localities) => {
        citySelect.innerHTML = "";
        cityOptionsPanel.innerHTML = "";
        const options = localities.length ? localities : [{ name: provinceName, code: provinceName }];
        options.forEach((locality, index) => {
          const option = document.createElement("option");
          option.value = locality.name.trim();
          option.textContent = locality.name.trim();
          citySelect.appendChild(option);

          const button = document.createElement("button");
          button.type = "button";
          button.className = "checkout-select-option";
          button.textContent = locality.name.trim();
          button.setAttribute("role", "option");
          button.setAttribute("aria-selected", String(index === 0));
          if (index === 0) button.classList.add("is-active");
          button.addEventListener("click", () => {
            citySelect.value = option.value;
            cityTriggerLabel.textContent = option.textContent;
            cityOptionsPanel.querySelectorAll(".checkout-select-option").forEach((item) => {
              item.classList.toggle("is-active", item === button);
              item.setAttribute("aria-selected", String(item === button));
            });
            cityCustomSelect.classList.remove("is-open");
            cityTrigger.setAttribute("aria-expanded", "false");
            cityOptionsPanel.hidden = true;
          });
          cityOptionsPanel.appendChild(button);
        });
        citySelect.disabled = false;
        cityTrigger.disabled = false;
        cityCustomSelect.classList.remove("is-disabled");
        cityTriggerLabel.textContent = options[0].name.trim();
        citySelect.value = options[0].name.trim();
        citySelect.dispatchEvent(new Event("change", { bubbles: true }));
      };

      provinceSelect?.addEventListener("change", async () => {
        const provinceName = provinceSelect.value;
        const requestId = ++localityRequestId;
        citySelect.value = "";
        citySelect.disabled = true;
        cityTrigger.disabled = true;
        cityCustomSelect.classList.add("is-disabled");
        cityTriggerLabel.textContent = provinceName ? "Loading localities..." : "Select City / Municipality";
        cityOptionsPanel.hidden = true;
        if (!provinceName) return;

        try {
          const localities = await loadLocalities();
          if (requestId !== localityRequestId) return;
          const canonicalProvinceName = provinceAliases[provinceName] || provinceName;
          const provinceLocalities = localities
            .filter((item) => item.province.trim().toLowerCase() === canonicalProvinceName.trim().toLowerCase())
            .map((item) => ({ name: item.locality.trim() }))
            .filter((item, index, items) => items.findIndex((candidate) => candidate.name.toLowerCase() === item.name.toLowerCase()) === index)
            .sort((a, b) => a.name.localeCompare(b.name));
          setCityOptions(provinceName, provinceLocalities);
        } catch (error) {
          if (requestId !== localityRequestId) return;
          console.error("Unable to load Philippine cities and municipalities:", error);
          setCityOptions(provinceName, []);
        }
      });

      document.querySelectorAll("[data-next-step]").forEach((button) => {
        button.addEventListener("click", () => {
          const currentPanel = button.closest("[data-step-panel]");
          const fields = [...currentPanel.querySelectorAll("input[required]")];
          if (fields.some((field) => !field.reportValidity())) return;
          if (Number(button.dataset.nextStep) === 3) {
            const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (character) => ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;"
            }[character]));
            const payment = document.querySelector('input[name="paymentMethod"]:checked');
            const billing = ["firstName", "lastName", "company", "address", "province", "city", "barangay", "zipCode", "phone", "email"]
              .map((id) => [id, document.getElementById(id)?.value || ""])
              .filter(([, value]) => value);
            const paymentLabels = { gcash: "GCash", card: "Card", cod: "Cash on delivery" };
            document.getElementById("reviewDetails").innerHTML = `
              <h3>Billing information</h3>
              <dl class="review-details-list">
                ${billing.map(([id, value]) => `<div><dt>${id === "zipCode" ? "Postal code" : id === "firstName" ? "First name" : id === "lastName" ? "Last name" : id.charAt(0).toUpperCase() + id.slice(1)}</dt><dd>${escapeHtml(value)}</dd></div>`).join("")}
              </dl>
              <h3>Payment method</h3>
              <p class="review-payment-method">${paymentLabels[payment?.value] || "Not selected"}</p>
              ${payment?.value === "card" ? `<p class="review-payment-method">Card ending in ${escapeHtml(document.getElementById("cardNumber").value.slice(-4))}</p>` : ""}
              ${payment?.value === "gcash" ? `<p class="review-payment-method">GCash number ending in ${escapeHtml(document.getElementById("gcashNumber").value.slice(-4))}</p>` : ""}
            `;
          }
          showStep(Number(button.dataset.nextStep));
        });
        document.querySelectorAll('input[name="paymentMethod"]').forEach((radio) => {
          radio.addEventListener("change", () => {
            const selectedPayment = document.querySelector('input[name="paymentMethod"]:checked')?.value;
            const cardDetails = document.getElementById("cardDetails");
            const gcashDetails = document.getElementById("gcashDetails");
            const isCard = selectedPayment === "card";
            const isGcash = selectedPayment === "gcash";
            cardDetails.hidden = !isCard;
            gcashDetails.hidden = !isGcash;
            cardDetails.querySelectorAll("input").forEach((input) => {
              input.required = isCard;
            });
            gcashDetails.querySelectorAll("input").forEach((input) => {
              input.required = isGcash;
            });
          });
        });
      });
      document.querySelectorAll("[data-prev-step]").forEach((button) => {
        button.addEventListener("click", () => showStep(Number(button.dataset.prevStep)));
      });

      const checkoutForm = document.getElementById("checkoutForm");
      checkoutForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        if (savedCart.length > 0 && checkoutItems.length === 0) {
          document.getElementById("checkoutConfirmBtn")?.focus();
          return;
        }
        const orderId = `LK-${Date.now().toString(36).toUpperCase()}`;
        const purchasedIds = new Set(checkoutItems.map((item) => String(item.id)));
        const remainingCart = getCart().filter((item) => !purchasedIds.has(String(item.id)));
        localStorage.setItem("circuitCart", JSON.stringify(remainingCart));
        const remainingSelectedIds = getSelectedCartIds(remainingCart);
        saveSelectedCartIds(remainingSelectedIds);
        const paymentToast = document.getElementById("paymentToast");
        const paymentToastOrder = document.getElementById("paymentToastOrder");
        if (paymentToast && paymentToastOrder) {
          paymentToastOrder.textContent = `Order ${orderId}`;
          paymentToast.classList.add("is-visible");
          document.getElementById("paymentSuccessBackdrop")?.classList.add("is-visible");
          document.querySelector(".checkout-page")?.setAttribute("inert", "");
          paymentToast.setAttribute("aria-hidden", "false");
        }
      });

      const avatarBtn = document.getElementById("avatarBtn");
      const dropdownWrapper = avatarBtn?.closest(".profile-dropdown-wrapper");
      if (avatarBtn && dropdownWrapper) {
        avatarBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          const isOpen = dropdownWrapper.classList.toggle("is-open");
          avatarBtn.setAttribute("aria-expanded", String(isOpen));
        });
        document.addEventListener("click", (e) => {
          if (!dropdownWrapper.contains(e.target)) {
            dropdownWrapper.classList.remove("is-open");
            avatarBtn.setAttribute("aria-expanded", "false");
          }
        });
      }
    });
  </script>
</body>
</html>
