<!DOCTYPE html>
<html lang="en" data-auth="<%= locals.currentUser ? 'true' : 'false' %>">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About Us — LabKit Market</title>
    <meta name="description"
        content="LabKit Market provides individual electronic parts for IoT and computer engineering projects. ESP32 microcontrollers, buzzers, microphone sensors, and wiring sold as single units with no minimum order." />
    <link rel="stylesheet" href="/css/about.css" />
    <link rel="stylesheet" href="/css/navbar.css" />
    <link rel="stylesheet" href="/css/cart.css" />
    <link rel="stylesheet" href="/css/navbar-search.css" />
    <script src="/js/theme.js"></script>
    <script src="/js/page-transitions.js"></script>
</head>

<body>

    <!-- ── NAVBAR ── -->
    <header class="navbar">
        <div class="container navbar__inner">
            <a href="/" class="navbar__brand">
                <span class="navbar__logo-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <rect width="16" height="16" x="4" y="4" rx="2" />
                        <rect width="6" height="6" x="9" y="9" />
                        <path d="M15 2v2" />
                        <path d="M15 20v2" />
                        <path d="M2 15h2" />
                        <path d="M2 9h2" />
                        <path d="M20 15h2" />
                        <path d="M20 9h2" />
                        <path d="M9 2v2" />
                        <path d="M9 20v2" />
                    </svg>
                </span>
                <span class="navbar__wordmark">LabKit</span>
                <span class="navbar__sub">/MARKET</span>
            </a>

            <nav class="navbar__nav">
                <a href="/" class="navbar__link">Home</a>
                <a href="/shop" class="navbar__link">Shop</a>
                <a href="/about" class="navbar__link navbar__link--active">About Us</a>
                <% if (locals.currentUser && (locals.currentUser.role === 'admin' || locals.userRole === 'admin')) { %>
                <a href="/admin" class="navbar__link navbar__link--admin">Admin</a>
                <% } %>
            </nav>

            <div class="navbar__actions">
                <div class="navbar-search">
                <button type="button" class="navbar__icon-btn navbar-search__toggle" aria-label="Search" aria-expanded="false">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                </button>
                <form class="navbar-search__form" action="/shop" method="get" role="search">
                    <input class="navbar-search__input" name="q" type="search" placeholder="Search products..." aria-label="Search products" />
                </form>
                </div>

                <button type="button" class="navbar__icon-btn navbar__cart" id="openCartBtn" aria-label="Cart">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1" />
                        <circle cx="20" cy="21" r="1" />
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
                    </svg>
                    <span class="navbar__cart-badge" id="cartBadge" style="display: none;">0</span>
                </button>

                <% if (locals.currentUser) { %>
                <div class="profile-dropdown-wrapper">
                    <button class="navbar__avatar-btn" id="avatarBtn" aria-label="User menu" aria-expanded="false">
                        <% if (locals.currentUser.avatar) { %>
                          <img src="<%= locals.currentUser.avatar %>" alt="User avatar" class="navbar__avatar" style="object-fit: cover; border-radius: 9999px;" />
                        <% } else { %>
                          <span class="navbar__avatar"><%= locals.currentUser.firstName ? locals.currentUser.firstName.charAt(0).toUpperCase() : 'U' %></span>
                        <% } %>
                        <svg class="navbar__avatar-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </button>

                    <div class="profile-dropdown" id="profileDropdown">
                        <div class="profile-dropdown__header">
                            <p class="profile-dropdown__name"><%= locals.currentUser.firstName %> <%= locals.currentUser.lastName %></p>
                            <p class="profile-dropdown__email"><%= locals.currentUser.email %></p>
                        </div>
                        <div class="profile-dropdown__divider"></div>
                        <% if (locals.currentUser && (locals.currentUser.role === 'admin' || locals.userRole === 'admin')) { %>
                        <a href="/admin" class="profile-dropdown__item profile-dropdown__item--admin">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                            <span>Admin Dashboard</span>
                        </a>
                        <% } %>
                        <a href="/settings" class="profile-dropdown__item">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="3" />
                                <path
                                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
                            </svg>
                            <span>Settings</span>
                        </a>
                        <a href="/logout" class="profile-dropdown__item" onclick="localStorage.removeItem('userEmail'); localStorage.removeItem('userName'); localStorage.removeItem('theme'); document.documentElement.classList.remove('dark');">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16 17 21 12 16 7" />
                                <line x1="21" y1="12" x2="9" y2="12" />
                            </svg>
                            <span>Sign out</span>
                        </a>
                    </div>
                </div>
                <% } else { %>
                <a href="/login" class="navbar__login-btn">Login</a>
                <% } %>
            </div>
        </div>
    </header>

    <main class="page-main">
        <!-- ── HERO SECTION ── -->
        <section class="about-hero">
            <div class="container about-hero__inner">
                <div class="about-hero__grid">
                    <div class="about-hero__content">
                        <h1 class="about-hero__title">Hardware built for your bench.</h1>
                        <p class="about-hero__desc">
                            We believe engineering students and makers shouldn't be forced to buy bloated starter kits packed
                            with components they will never use. LabKit Market delivers individual microcontrollers, sensors,
                            buzzers, and wiring — bench-checked before shipping, with no minimum orders.
                        </p>
                        <div class="about-hero__metrics">
                            <span class="hero-highlight">Single units · Zero minimum order</span>
                            <span class="hero-highlight">100% bench-checked before dispatch</span>
                            <span class="hero-highlight">Pinouts &amp; datasheets included</span>
                        </div>
                    </div>
                    <figure class="about-hero__figure">
                        <img src="/img/electronics-workbench.jpg" alt="Electronics workbench with oscilloscope, multimeter, and components" class="about-hero__img" width="560" height="420" />
                        <figcaption class="about-hero__caption">Hardware test bench — verified single units ready for breadboard prototyping.</figcaption>
                    </figure>
                </div>
            </div>
        </section>

        <!-- ── 4-STEP TIMELINE SECTION ── -->
        <section class="steps-section">
            <div class="container">
                <div class="steps-header">
                    <h2 class="steps-header__title">From schematic to breadboard</h2>
                    <p class="steps-header__desc">No forced bundles. No guessing if modules will work together. Here is how we support your engineering build.</p>
                </div>

                <div class="timeline-visual">
                    <figure class="timeline-figure">
                        <img src="/img/breadboard-circuit.jpg" alt="Breadboard circuit prototyping" class="timeline-img" width="800" height="340" loading="lazy" />
                        <figcaption class="timeline-caption">Bench verification — components placed and checked on solderless breadboards before packaging.</figcaption>
                    </figure>
                </div>

                <div class="timeline-list">
                    <!-- Step 01 -->
                    <div class="timeline-item">
                        <div class="timeline-card">
                            <h2 class="timeline-title">Pick your individual parts</h2>
                            <p class="timeline-text">
                                Order single units of ESP32 dev boards, piezo buzzers, microphone sound modules, ultrasonic sensors, or 40-pin jumper wires. Select exact quantities for your schematic with zero filler.
                            </p>
                            <div class="timeline-meta">
                                <span class="meta-chip">Zero bundle bloat</span>
                                <span class="meta-chip">Single-unit pricing</span>
                                <span class="meta-chip">Exact quantities</span>
                            </div>
                        </div>
                    </div>

                    <!-- Step 02 -->
                    <div class="timeline-item">
                        <div class="timeline-card">
                            <h2 class="timeline-title">Review pinouts & voltage specs</h2>
                            <p class="timeline-text">
                                Check 3.3V vs 5V logic compatibility, GPIO pin mappings, and sensor operating limits upfront. We provide clear pinout references for every module so you wire up without guessing.
                            </p>
                            <div class="timeline-meta">
                                <span class="meta-chip">Clear pinouts</span>
                                <span class="meta-chip">Operating voltages</span>
                                <span class="meta-chip">Logic level specs</span>
                            </div>
                        </div>
                    </div>

                    <!-- Step 03 -->
                    <div class="timeline-item">
                        <div class="timeline-card">
                            <h2 class="timeline-title">Tested on the laboratory bench</h2>
                            <p class="timeline-text">
                                Every microcontroller, buzzer, and sensor is powered and verified on our test bench before packaging into anti-static protective bags. Zero duds, zero dead-on-arrival surprises.
                            </p>
                            <div class="timeline-meta">
                                <span class="meta-chip">Bench-verified</span>
                                <span class="meta-chip">Anti-static packaging</span>
                                <span class="meta-chip">24h dispatch</span>
                            </div>
                        </div>
                    </div>

                    <!-- Step 04 -->
                    <div class="timeline-item">
                        <div class="timeline-card">
                            <h2 class="timeline-title">Wire up and build with confidence</h2>
                            <p class="timeline-text">
                                Plug components directly into your breadboard or custom PCB. Perfect for IoT telemetry, sound triggers, home automation projects, and university computer engineering lab exercises.
                            </p>
                            <div class="timeline-meta">
                                <span class="meta-chip">Breadboard ready</span>
                                <span class="meta-chip">Maker tested</span>
                                <span class="meta-chip">Reliable operation</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── WHAT WE SUPPLY (INDIVIDUAL HARDWARE CATEGORIES) ── -->
        <section class="bundle-assets-section">
            <div class="container">
                <div class="bundle-box">
                    <div class="bundle-box__header">
                        <h2 class="bundle-box__title">Hardware built for IoT & computer projects</h2>
                    </div>
                    <p class="bundle-box__desc">
                        Tested single-unit components for student lab benches and maker workstations. Buy only what you need.
                    </p>

                    <div class="bench-photo-strip">
                        <figure class="bench-strip__item">
                            <img src="/img/reparieren-und-basteln-29983460260.jpg" alt="Maker workbench with soldering equipment and electronics assembly" class="bench-strip__img" width="560" height="320" loading="lazy" />
                            <figcaption class="bench-strip__caption">Workstation assembly and soldering reference bench.</figcaption>
                        </figure>
                        <figure class="bench-strip__item">
                            <img src="/img/home-electronics-lab.jpg" alt="Home electronics testing setup with oscilloscope and meter" class="bench-strip__img" width="560" height="320" loading="lazy" />
                            <figcaption class="bench-strip__caption">Hardware test bench with oscilloscope and multimeter instrumentation.</figcaption>
                        </figure>
                    </div>

                    <div class="assets-grid">
                        <!-- Card 1: Microcontrollers -->
                        <div class="asset-card">
                            <h3 class="asset-card__title">Microcontrollers & Boards</h3>
                            <p class="asset-card__subtitle">ESP32 · Arduino · RP2040</p>
                            <p class="asset-card__text">
                                Dual-core Wi-Fi & Bluetooth boards with full GPIO headers ready for sensor inputs, motor drivers, and cloud IoT telemetry.
                            </p>
                            <div class="asset-card__footer">
                                <span>Tested clock & Wi-Fi radios</span>
                            </div>
                        </div>

                        <!-- Card 2: Buzzers & Audio -->
                        <div class="asset-card">
                            <h3 class="asset-card__title">Buzzers & Audio Output</h3>
                            <p class="asset-card__subtitle">Active & Passive Buzzers</p>
                            <p class="asset-card__text">
                                5V active and passive piezo buzzers for audible alarms, system tone generators, and acoustic feedback indicators.
                            </p>
                            <div class="asset-card__footer">
                                <span>Verified audible frequency</span>
                            </div>
                        </div>

                        <!-- Card 3: Sensors & Modules -->
                        <div class="asset-card">
                            <h3 class="asset-card__title">Sensors & Input Modules</h3>
                            <p class="asset-card__subtitle">Microphone · Ultrasonic · DHT11</p>
                            <p class="asset-card__text">
                                High-sensitivity sound detection modules, ultrasonic distance sensors, and environmental monitoring probes.
                            </p>
                            <div class="asset-card__footer">
                                <span>Analog & digital outputs</span>
                            </div>
                        </div>
                    </div>

                    <div class="bundle-box__action">
                        <a href="/shop" class="btn-primary">
                            Browse shop parts
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12" />
                                <polyline points="12 5 19 12 12 19" />
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── 4 PILLARS OF OUR HARDWARE PROMISE ── -->
        <section class="pillars-section">
            <div class="container">
                <div class="pillars-grid">
                    <div class="pillar-item">
                        <h3 class="pillar-title">Single-unit ordering</h3>
                        <p class="pillar-text">Buy exactly one buzzer or thirty resistors. Never pay for unwanted parts in bloated bundles.</p>
                    </div>

                    <div class="pillar-item">
                        <h3 class="pillar-title">Bench-checked hardware</h3>
                        <p class="pillar-text">Every microcontroller, module, and buzzer is tested for continuity and logic before dispatch.</p>
                    </div>

                    <div class="pillar-item">
                        <h3 class="pillar-title">Datasheets & pinouts</h3>
                        <p class="pillar-text">Complete pin mappings and operating voltage guides for seamless breadboard prototyping.</p>
                    </div>

                    <div class="pillar-item">
                        <h3 class="pillar-title">Fast 24-hour dispatch</h3>
                        <p class="pillar-text">In-stock parts ship within 24 hours in anti-static ESD packaging straight to your workbench.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── INTERACTIVE COMPONENT PINOUT INSPECTOR ── -->
        <section class="demo-vault-section">
            <div class="container">
                <div class="steps-header">
                    <h2 class="steps-header__title">Interactive hardware pinout inspector</h2>
                    <p class="steps-header__desc">Switch tabs below to view verified pinouts and wiring guides for popular IoT components.</p>
                </div>

                <div class="demo-vault-card">
                    <div class="demo-vault__topbar">
                        <span class="demo-vault__title">Hardware bench pinout and voltage reference</span>

                        <div class="demo-tabs" role="tablist">
                            <button class="demo-tab-btn is-active" data-target="tab-esp32">ESP32 DevKit</button>
                            <button class="demo-tab-btn" data-target="tab-buzzer">Active Buzzer</button>
                            <button class="demo-tab-btn" data-target="tab-mic">Microphone Module</button>
                        </div>
                    </div>

                    <div class="demo-vault__content">
                        <!-- Tab 1: ESP32 -->
                        <div class="vault-tab-pane is-active" id="tab-esp32">
                            <div class="schematic-box">
                                <div class="schematic-nodes">
                                    <div class="schematic-node">3.3V Power Rail</div>
                                    <span class="schematic-wire">&harr; GPIO 21 / 22 (I2C) &harr;</span>
                                    <div class="schematic-node">ESP32-WROOM-32D</div>
                                    <span class="schematic-wire">&harr; GPIO 18 / 19 (SPI) &harr;</span>
                                    <div class="schematic-node">GND Ground Bus</div>
                                </div>
                                <p style="font-size: 0.875rem; color: hsl(var(--muted-foreground)); max-width: 36rem;">
                                    Dual-core 240MHz Xtensa LX6 microcontroller with 802.11 b/g/n Wi-Fi, BLE 4.2, and 30 GPIO headers. Operates at 3.3V logic levels.
                                </p>
                            </div>
                            <pre class="code-preview" style="margin-top: 1.25rem;"><code><span class="c-com">// ESP32 GPIO Configuration Example</span>
<span class="c-kw">#include</span> <span class="c-str">&lt;WiFi.h&gt;</span>

<span class="c-kw">const int</span> BUZZER_PIN = 12;   <span class="c-com">// GPIO 12 for alert buzzer</span>
<span class="c-kw">const int</span> SOUND_PIN = 34;    <span class="c-com">// GPIO 34 (ADC1) for mic analog input</span>

<span class="c-fn">void setup</span>() {
  Serial.<span class="c-fn">begin</span>(115200);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(SOUND_PIN, INPUT);
  WiFi.<span class="c-fn">begin</span>(<span class="c-str">"LabKit_IoT"</span>, <span class="c-str">"secure_pass"</span>);
}</code></pre>
                        </div>

                        <!-- Tab 2: Buzzer -->
                        <div class="vault-tab-pane" id="tab-buzzer">
                            <div class="schematic-box">
                                <div class="schematic-nodes">
                                    <div class="schematic-node">MCU GPIO (3.3V / 5V)</div>
                                    <span class="schematic-wire">&mdash; Positive (+) Pin &mdash;</span>
                                    <div class="schematic-node">5V Active Piezo Buzzer</div>
                                    <span class="schematic-wire">&mdash; Negative (-) Pin &mdash;</span>
                                    <div class="schematic-node">Common GND</div>
                                </div>
                                <p style="font-size: 0.875rem; color: hsl(var(--muted-foreground)); max-width: 36rem;">
                                    Built-in internal oscillating circuit produces a continuous 2.3kHz tone as soon as voltage is applied. No external frequency square wave required.
                                </p>
                            </div>
                            <pre class="code-preview" style="margin-top: 1.25rem;"><code><span class="c-com">// Active Buzzer Alarm Trigger</span>
<span class="c-fn">void soundAlarm</span>(<span class="c-kw">int</span> durationMs) {
  digitalWrite(BUZZER_PIN, HIGH); <span class="c-com">// Buzzer ON (continuous tone)</span>
  delay(durationMs);
  digitalWrite(BUZZER_PIN, LOW);  <span class="c-com">// Buzzer OFF</span>
}</code></pre>
                        </div>

                        <!-- Tab 3: Microphone Sensor -->
                        <div class="vault-tab-pane" id="tab-mic">
                            <div class="schematic-box">
                                <div class="schematic-nodes">
                                    <div class="schematic-node">VCC (3.3V - 5V) / GND</div>
                                    <span class="schematic-wire">&mdash; Power &mdash;</span>
                                    <div class="schematic-node">KY-038 Sound Module</div>
                                    <span class="schematic-wire">&mdash; AO (Analog) & DO (Digital) &mdash;</span>
                                    <div class="schematic-node">MCU ADC & Interrupt</div>
                                </div>
                                <p style="font-size: 0.875rem; color: hsl(var(--muted-foreground)); max-width: 36rem;">
                                    High-sensitivity electret capsule with on-board LM393 comparator. Features an adjustable trimmer potentiometer to set digital sound trigger thresholds.
                                </p>
                            </div>
                            <pre class="code-preview" style="margin-top: 1.25rem;"><code><span class="c-com">// Acoustic Trigger & Sound Level Detection</span>
<span class="c-fn">void loop</span>() {
  <span class="c-kw">int</span> soundLevel = analogRead(SOUND_PIN);
  <span class="c-kw">if</span> (soundLevel &gt; 2500) {
    soundAlarm(200); <span class="c-com">// Trigger buzzer on sound threshold</span>
  }
}</code></pre>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ── FAQ SECTION ── -->
        <section class="faq-section">
            <div class="container">
                <div class="steps-header">
                    <h2 class="steps-header__title">Frequently asked questions</h2>
                    <p class="steps-header__desc">Everything you need to know about our individual components and shipping.</p>
                </div>

                <div class="faq-grid">
                    <div class="faq-item">
                        <button class="faq-question">
                            <span>Can I buy individual parts without ordering a full bundle?</span>
                            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </button>
                        <div class="faq-answer">
                            Yes! That is our entire premise. Every component in our catalog — whether an ESP32 microcontroller, an active buzzer, a microphone module, or jumper wires — is sold as an individual single unit with no minimum order requirements.
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question">
                            <span>Are all components bench-tested before shipping?</span>
                            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </button>
                        <div class="faq-answer">
                            Yes. Every microcontroller, sensor, and buzzer is tested on our hardware test bench before being packed into anti-static protective bags. You never have to worry about dead boards or non-functioning buzzers arriving at your bench.
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question">
                            <span>Do components include pinout diagrams and datasheets?</span>
                            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9" />
                            </svg>
                        </button>
                        <div class="faq-answer">
                            Yes. Every part includes clear pin allocations, operating voltage ratings (such as 3.3V vs 5V logic considerations), and recommended wiring notes so you can immediately connect it into your project safely.
                        </div>
                    </div>

                    <div class="faq-item">
                        <button class="faq-question">
                            <span>What kinds of projects are these parts intended for?</span>
