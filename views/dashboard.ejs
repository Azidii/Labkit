<!DOCTYPE html>
<html lang="en" data-auth="<%= locals.currentUser ? 'true' : 'false' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LabKit Market — Individual Parts for Engineers</title>
  <meta name="description"
    content="A marketplace for engineering students and hobbyists. Individual electronic parts sold as single units — buzzers, sensors, boards, motors and more." />
  <link rel="stylesheet" href="/css/dashboard.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/cart.css" />
  <link rel="stylesheet" href="/css/navbar-search.css" />
  <script src="/js/theme.js"></script>
  <script src="/js/page-transitions.js"></script>
</head>

<body>

  <header class="navbar">
    <div class="container navbar__inner">
      <a href="/" class="navbar__brand">
        <span class="navbar__logo-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <rect width="16" height="16" x="4" y="4" rx="2" />
            <rect width="6" height="6" x="9" y="9" />
            <path d="M15 2v2" />
            <path d="M15 20v2" />
            <path d="M2 15h2" />
            <path d="M2 9h2" />
            <path d="M20 15h2" />
            <path d="M20 9h2" />
            <path d="M9 2v2" />
            <path d="M9 20v2" />
          </svg>
        </span>
        <span class="navbar__wordmark">LabKit</span>
        <span class="navbar__sub">/MARKET</span>
      </a>

      <nav class="navbar__nav">
        <a href="/" class="navbar__link navbar__link--active">Home</a>
        <a href="/shop" class="navbar__link">Shop</a>
        <a href="/about" class="navbar__link">About Us</a>
        <% if (locals.currentUser && (locals.currentUser.role === 'admin' || locals.userRole === 'admin')) { %>
        <a href="/admin" class="navbar__link navbar__link--admin">Admin</a>
        <% } %>
      </nav>

      <div class="navbar__actions">
        <div class="navbar-search">
        <button type="button" class="navbar__icon-btn navbar-search__toggle" aria-label="Search" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
        <form class="navbar-search__form" action="/shop" method="get" role="search">
          <input class="navbar-search__input" name="q" type="search" placeholder="Search products..." aria-label="Search products" />
        </form>
        </div>

        <button type="button" class="navbar__icon-btn navbar__cart" id="openCartBtn" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1" />
            <circle cx="20" cy="21" r="1" />
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
          </svg>
          <span class="navbar__cart-badge" id="cartBadge" style="display: none;">0</span>
        </button>

        <% if (locals.currentUser) { %>
        <div class="profile-dropdown-wrapper">
          <button class="navbar__avatar-btn" id="avatarBtn" aria-label="User menu" aria-expanded="false">
            <% if (locals.currentUser.avatar) { %>
              <img src="<%= locals.currentUser.avatar %>" alt="User avatar" class="navbar__avatar" style="object-fit: cover; border-radius: 9999px;" />
            <% } else { %>
              <span class="navbar__avatar"><%= locals.currentUser.firstName ? locals.currentUser.firstName.charAt(0).toUpperCase() : 'U' %></span>
            <% } %>
            <svg class="navbar__avatar-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>

          <div class="profile-dropdown" id="profileDropdown">
            <div class="profile-dropdown__header">
              <p class="profile-dropdown__name"><%= locals.currentUser.firstName %> <%= locals.currentUser.lastName %></p>
              <p class="profile-dropdown__email"><%= locals.currentUser.email %></p>
            </div>
            <div class="profile-dropdown__divider"></div>
            <% if (locals.currentUser && (locals.currentUser.role === 'admin' || locals.userRole === 'admin')) { %>
            <a href="/admin" class="profile-dropdown__item profile-dropdown__item--admin">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span>Admin Dashboard</span>
            </a>
            <% } %>
            <a href="/settings" class="profile-dropdown__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3" />
                <path
                  d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
              </svg>
              <span>Settings</span>
            </a>
            <a href="/logout" class="profile-dropdown__item" onclick="localStorage.removeItem('userEmail'); localStorage.removeItem('userName'); localStorage.removeItem('theme'); document.documentElement.classList.remove('dark');">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              <span>Sign out</span>
            </a>
          </div>
        </div>
        <% } else { %>
        <a href="/login" style="display: inline-flex; align-items: center; justify-content: center; padding: 0.45rem 1rem; font-size: 0.875rem; font-weight: 500; border-radius: 0.375rem; background: hsl(var(--primary)); color: #ffffff; text-decoration: none; transition: opacity 0.15s ease;">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <main class="page-main">
    <!-- ── HERO ── -->
    <section class="hero">
      <div class="container">
        <div class="hero__inner">
          <span class="hero__badge">
            <span class="hero__dot">
              <span class="hero__dot-ping"></span>
              <span class="hero__dot-core"></span>
            </span>
            Individual parts · sold as single units
          </span>

          <h1>
            Every part your project needs
            — <span class="accent">buzzers, boards, and beyond.</span>
          </h1>

          <p class="hero__desc">
            A marketplace for engineering students and hobbyists who buy exactly what they
            need. From piezo buzzers and ultrasonic sensors to ESP32 boards and Raspberry Pi
            — every part is sold individually, tested before it ships, with no minimum order.
          </p>

          <div class="hero__actions">
            <a href="/shop" class="btn btn--primary">
              Browse the shop
              <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
            <a href="/about" class="btn btn--outline">
              How ordering works
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── VALUE PROPS ── -->
    <section class="value-props">
      <div class="container value-props__inner">
        <div class="value-props__grid">
          <% const valueProps=[ { title: "Tested before shipping" ,
            text: "Every unit is bench-checked before it leaves — no dead boards, no dud buzzers." }, {
            title: "Single units, no minimums" ,
            text: "Buy exactly one buzzer or twenty sensors. Parts are sold individually, always." }, {
            title: "Fast shipping" , text: "In-stock parts ship within 24 hours, packed for safe transit to your bench."
            }, { title: "Datasheets included" ,
            text: "Pinouts and datasheets for every module so you can wire it up without guessing." }, ]; %>
            <% valueProps.forEach(function(f, i) { %>
              <div class="value-card">
                <div class="value-card__icon">
                  <% if (i===0) { %>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                    </svg>
                    <% } else if (i===1) { %>
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                      </svg>
                      <% } else if (i===2) { %>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="1" y="3" width="15" height="13" />
                          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
                          <circle cx="5.5" cy="18.5" r="2.5" />
                          <circle cx="18.5" cy="18.5" r="2.5" />
                        </svg>
                        <% } else { %>
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <polyline points="12 6 12 12 16 14" />
                          </svg>
                          <% } %>
                </div>
                <h3>
                  <%= f.title %>
                </h3>
                <p>
                  <%= f.text %>
                </p>
              </div>
              <% }); %>
        </div>
      </div>
    </section>

    <!-- ── FEATURED PARTS ── -->
    <section class="featured">
      <div class="container">
        <div class="featured__header">
          <div>
            <h2>Featured parts</h2>
            <p class="subtitle">The components our community keeps coming back for.</p>
          </div>
          <a href="/shop" class="featured__view-all">
            View all
            <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>

        <% if (loading) { %>
          <div class="product-grid">
            <% for (let i=0; i < 4; i++) { %>
              <div class="skeleton"></div>
              <% } %>
          </div>
          <% } else if (!featured || featured.length===0) { %>
            <p class="product-grid__empty">No parts yet — check back soon.</p>
            <% } else { %>
              <div class="product-grid">
                <% featured.forEach(function(p) { %>
                  <div class="product-card" data-slug="<%= p.slug %>">
                    <div class="product-card__img-wrap">
                      <div class="product-card__badges">
                        <span class="product-card__cat-badge">
                          <%= p.category %>
                        </span>
                        <% if (p.difficulty) { %>
                          <span
                            class="product-card__diff-badge product-card__diff-badge--<%= p.difficulty.toLowerCase().replace(/\s/g, '-') %>">
                            <%= p.difficulty %>
                          </span>
                          <% } %>
                      </div>
                      <img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy" />
                    </div>
                    <div class="product-card__body">
                      <h3 class="product-card__name">
                        <%= p.name %>
                      </h3>
                      <p class="product-card__tagline">
                        <%= p.tagline %>
                      </p>
                      <div class="product-card__meta">
                        <span class="product-card__rating">
                          ★ <%= p.rating ? p.rating.toFixed(1) : '—' %>
                            <span class="product-card__review-count">(<%= p.review_count || 0 %>)</span>
                        </span>
                        <span class="product-card__unit-tag">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                          </svg>
                          Single unit
                        </span>
                      </div>
                      <div class="product-card__footer">
                        <span class="product-card__price">₱<%= p.price.toFixed(2) %></span>
                        <button type="button" class="product-card__add-btn js-add-to-cart"
                          data-id="<%= p.id %>"
                          data-name="<%= (p.name || '').replace(/["']/g, '') %>"
                          data-price="<%= p.price %>"
                          data-img="<%= p.image_url %>"
                          data-max="10"
                          aria-label="Add to cart">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19" />
                            <line x1="5" y1="12" x2="19" y2="12" />
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                  <% }); %>
              </div>
              <% } %>
      </div>
    </section>

    <!-- ── SHOP BY DOMAIN ── -->
    <section id="categories" class="categories">
      <div class="container categories__inner">
        <h2>Shop by domain</h2>
        <p class="subtitle">Parts grouped by the engineering discipline they serve.</p>
        <div class="categories__grid">
          <% const categories=[ { name: "Microcontrollers" , desc: "ESP32, Arduino, STM32 boards" }, {
            name: "Sensors & Modules" , desc: "Ultrasonic, DHT11, PIR sensors" }, { name: "Buzzers & Audio" ,
            desc: "Piezo buzzers & speakers" }, { name: "Motors & Actuators" , desc: "Servo & DC motors" }, {
            name: "Single-Board Computers" , desc: "Raspberry Pi, Orange Pi" }, { name: "Displays & Power" ,
            desc: "OLEDs, LCDs & regulators" }, ]; %>
            <% categories.forEach(function(c) { %>
              <a href="/shop?category=<%= encodeURIComponent(c.name) %>" class="category-card">
                <div class="category-card__inner">
                  <div>
                    <h3>
                      <%= c.name %>
                    </h3>
                    <p class="category-card__count">
                      <%= c.desc %>
                    </p>
                  </div>
                  <svg class="category-card__arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </div>
              </a>
              <% }); %>
        </div>
      </div>
    </section>

    <!-- ── CTA ── -->
    <section class="cta">
      <div class="container">
        <div class="cta__card">
          <div class="cta__grid-overlay"></div>
          <div class="cta__inner">
            <div>
              <span class="cta__badge">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round">
                  <rect width="16" height="16" x="4" y="4" rx="2" />
                  <rect width="6" height="6" x="9" y="9" />
                  <path d="M15 2v2" /><path d="M15 20v2" />
                  <path d="M2 15h2" /><path d="M2 9h2" />
                  <path d="M20 15h2" /><path d="M20 9h2" />
                  <path d="M9 2v2" /><path d="M9 20v2" />
                </svg>
                IoT Hardware Essentials
              </span>
              <h2>No bulky kits. Buy only the exact IoT parts you need.</h2>
              <p class="cta__desc">
                Tired of paying for starter kits full of parts you'll never use? Pick individual ESP32 microcontrollers,
                microphone sound modules, jumper wires, resistor packs, and buzzers. Every unit is bench-checked,
                sold as a single piece with no minimum order.
              </p>
              <a href="/shop" class="btn btn--secondary">
                Explore IoT parts
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </a>
            </div>
            <div class="vault-files">
              <!-- Category 1: Microcontrollers -->
              <a href="/shop?category=Microcontrollers" class="vault-file">
                <div class="vault-file__icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                    stroke-linecap="round" stroke-linejoin="round">
                    <rect width="16" height="16" x="4" y="4" rx="2" />
                    <rect width="6" height="6" x="9" y="9" />
                    <path d="M15 2v2" /><path d="M15 20v2" />
                    <path d="M2 15h2" /><path d="M2 9h2" />
                    <path d="M20 15h2" /><path d="M20 9h2" />
                    <path d="M9 2v2" /><path d="M9 20v2" />
                  </svg>
                </div>
                <div class="vault-file__info">
                  <p class="vault-file__name">Microcontrollers</p>
                  <p class="vault-file__note">ESP32 DevKit V1 (WROOM-32) &amp; dev boards</p>
                </div>
                <span class="vault-file__arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </span>
              </a>

              <!-- Category 2: Sensors & Modules -->
              <a href="/shop?category=<%= encodeURIComponent('Sensors & Modules') %>" class="vault-file">
                <div class="vault-file__icon" style="color: #a78bfa; border-color: rgba(167, 139, 250, 0.25); background: rgba(139, 92, 246, 0.12);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" />
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                    <line x1="12" y1="19" x2="12" y2="22" />
                  </svg>
                </div>
                <div class="vault-file__info">
                  <p class="vault-file__name">Sensors &amp; Modules</p>
                  <p class="vault-file__note">KY-038 Microphone, ultrasonic &amp; detectors</p>
                </div>
                <span class="vault-file__arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </span>
              </a>

              <!-- Category 3: Displays & Power -->
              <a href="/shop?category=<%= encodeURIComponent('Displays & Power') %>" class="vault-file">
                <div class="vault-file__icon" style="color: #34d399; border-color: rgba(52, 211, 153, 0.25); background: rgba(16, 185, 129, 0.12);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                  </svg>
                </div>
                <div class="vault-file__info">
                  <p class="vault-file__name">Displays &amp; Power</p>
                  <p class="vault-file__note">40-Pin jumper wires, resistors &amp; OLEDs</p>
                </div>
                <span class="vault-file__arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </span>
              </a>

              <!-- Category 4: Buzzers & Audio -->
              <a href="/shop?category=<%= encodeURIComponent('Buzzers & Audio') %>" class="vault-file">
                <div class="vault-file__icon" style="color: #fbbf24; border-color: rgba(251, 191, 36, 0.25); background: rgba(245, 158, 11, 0.12);">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                    stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07" />
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14" />
                  </svg>
                </div>
                <div class="vault-file__info">
                  <p class="vault-file__name">Buzzers &amp; Audio</p>
                  <p class="vault-file__note">5V active piezo buzzers &amp; tone modules</p>
                </div>
                <span class="vault-file__arrow" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </span>
              </a>

              <!-- Category 5: IoT Kits -->
