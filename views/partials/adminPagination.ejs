<% if (totalPages > 1) { %>
<nav class="catalog-pagination" aria-label="<%= activeTab === 'accounts' ? 'Account' : 'Product' %> pages">
  <% if (currentPage > 1) { %><a href="<%= listingUrl({ page: String(currentPage - 1) }) %>" rel="prev">Previous</a><% } else { %><span aria-disabled="true">Previous</span><% } %>
  <div class="catalog-pagination__pages">
    <% pageNumbers.forEach((pageNumber, index) => { %>
      <% if (index && pageNumber - pageNumbers[index - 1] > 1) { %><span aria-hidden="true">…</span><% } %>
      <% if (pageNumber === currentPage) { %><span class="is-current" aria-current="page" aria-label="Page <%= pageNumber %>"><%= pageNumber %></span><% } else { %><a href="<%= listingUrl({ page: String(pageNumber) }) %>" aria-label="Page <%= pageNumber %>"><%= pageNumber %></a><% } %>
    <% }) %>
  </div>
  <% if (currentPage < totalPages) { %><a href="<%= listingUrl({ page: String(currentPage + 1) }) %>" rel="next">Next</a><% } else { %><span aria-disabled="true">Next</span><% } %>
</nav>
<% } %>
