<!DOCTYPE html>
<html lang="en" data-auth="<%= locals.currentUser ? 'true' : 'false' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log in — LabKit Market</title>
  <link rel="stylesheet" href="/css/login.css" />
  <script src="/js/theme.js"></script>
  <script src="/js/page-transitions.js"></script>
</head>
<body>
  <main class="split-layout page-main">
    
    <div class="brand-panel">
      <div class="brand-panel__grid"></div>
      <div class="brand-panel__inner">
        <header class="brand-panel__header">
          <a href="/" class="brand-logo">
            <span class="brand-logo__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="16" height="16" x="4" y="4" rx="2"/>
                <rect width="6" height="6" x="9" y="9"/>
                <path d="M15 2v2"/><path d="M15 20v2"/>
                <path d="M2 15h2"/><path d="M2 9h2"/>
                <path d="M20 15h2"/><path d="M20 9h2"/>
                <path d="M9 2v2"/><path d="M9 20v2"/>
              </svg>
            </span>
            <span class="brand-logo__wordmark">LabKit</span>
            <span class="brand-logo__sub">/MARKET</span>
          </a>
        </header>

        <div class="brand-panel__content">
          <h1 class="brand-panel__title">
            The kit is physical. The schematics are instant.
          </h1>
          <p class="brand-panel__desc">
            Every purchase unlocks a private download vault: the circuit diagram, the Packet Tracer topology, and the integration code &mdash; all available the second your order is confirmed. Start building before the box even arrives.
          </p>

          <div class="vault-list">
            <div class="vault-card">
              <span class="vault-card__icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <line x1="16" y1="13" x2="8" y2="13"/>
                  <line x1="16" y1="17" x2="8" y2="17"/>
                  <polyline points="10 9 9 9 8 9"/>
                </svg>
              </span>
              <span class="vault-card__name">circuit-diagram.pdf</span>
            </div>

            <div class="vault-card">
              <span class="vault-card__icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="5" r="3"/>
                  <circle cx="6" cy="19" r="3"/>
                  <circle cx="18" cy="19" r="3"/>
                  <path d="M12 8v4"/>
                  <path d="M6 16l6-4 6 4"/>
                </svg>
              </span>
              <span class="vault-card__name">topology.pkt</span>
            </div>

            <div class="vault-card">
              <span class="vault-card__icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 18 22 12 16 6"/>
                  <polyline points="8 6 2 12 8 18"/>
                </svg>
              </span>
              <span class="vault-card__name">firmware.zip</span>
            </div>
          </div>
        </div>

        <footer class="brand-panel__footer">
          <p>© 2026 LabKit Market</p>
        </footer>
      </div>
    </div>

    
    <div class="form-panel">
      <div class="form-panel__inner">
        <div class="form-panel__header">
          <h2 class="form-panel__title">Welcome back</h2>
          <p class="form-panel__subtitle">Log in to your account to continue.</p>
        </div>

        <div id="alertBox"></div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="auth-alert auth-alert--error" role="alert">
            <svg class="alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="auth-alert auth-alert--success" role="alert">
            <svg class="alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            <span><%= success %></span>
          </div>
        <% } %>

        <a href="/login/google" class="btn-google">
          <svg class="google-icon" width="18" height="18" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"/>
            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.15z"/>
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
          </svg>
          Continue with Google
        </a>

        <div class="divider">
          <span>OR</span>
        </div>

        <form action="/login" method="POST" class="auth-form" id="loginForm">
          <div class="form-group">
            <label for="email" class="form-label">Email or Username</label>
            <div class="input-wrap">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <input type="text" id="email" name="email" class="form-input" placeholder="you@example.com or username" required autocomplete="username" />
            </div>
          </div>

          <div class="form-group">
            <div class="label-row">
              <label for="password" class="form-label">Password</label>
              <a href="/resetpass" class="forgot-link">Forgot password?</a>
            </div>
            <div class="input-wrap">
              <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" required autocomplete="current-password" />
            </div>
          </div>

          <button type="submit" class="btn-submit">
            <span>Log in</span>
            <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </button>
        </form>

        <p class="auth-footer">
          Don't have an account? <a href="/register" class="auth-link">Create one</a>
        </p>
      </div>
    </div>
  </main>

  <script src="/js/login.js"></script>
</body>
</html>
