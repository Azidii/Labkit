                            <pre class="code-preview"><code><span class="c-com">// ESP32 Sensor Ingest & MQTT Publisher</span>
<span class="c-kw">#include</span> <span class="c-str">&lt;WiFi.h&gt;</span>
<span class="c-kw">#include</span> <span class="c-str">&lt;PubSubClient.h&gt;</span>
<span class="c-kw">#include</span> <span class="c-str">"DHTesp.h"</span>

DHTesp dht;
<span class="c-kw">const int</span> DHT_PIN = 4;

<span class="c-fn">void setup</span>() {
  Serial.<span class="c-fn">begin</span>(115200);
  dht.<span class="c-fn">setup</span>(DHT_PIN, DHTesp::DHT11);
  WiFi.<span class="c-fn">begin</span>(<span class="c-str">"LabKit_AP"</span>, <span class="c-str">"bench_key_99"</span>);
  <span class="c-com">// Vault scripts include automatic reconnect & MQTT telemetry loops</span>
}</code></pre>
                        </div>
                    </div>
                </div>
