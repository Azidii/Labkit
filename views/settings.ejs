<!DOCTYPE html>
<html lang="en" data-auth="<%= locals.currentUser ? 'true' : 'false' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Settings — LabKit Market</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/settings.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/cart.css" />
  <link rel="stylesheet" href="/css/navbar-search.css" />
  <script src="/js/theme.js"></script>
  <script src="/js/page-transitions.js"></script>
</head>

<body>


  <header class="navbar">
    <div class="container navbar__inner">
      <a href="/" class="navbar__brand">
        <span class="navbar__logo">
          <img src="/img/LK_light.png" alt="LabKit Logo" class="navbar__logo-img navbar__logo-img--light" width="36" height="36" />
          <img src="/img/LK_dark.png" alt="LabKit Logo" class="navbar__logo-img navbar__logo-img--dark" width="36" height="36" />
        </span>
        <span class="navbar__brand-text">
          <span class="navbar__wordmark"><span class="navbar__wordmark-lab">Lab</span><span class="navbar__wordmark-kit">Kit</span></span>
          <span class="navbar__sub">/MARKET</span>
        </span>
      </a>

      <nav class="navbar__nav">
        <a href="/" class="navbar__link">Home</a>
        <a href="/shop" class="navbar__link">Shop</a>
        <a href="/about" class="navbar__link">About Us</a>
      </nav>

      <div class="navbar__actions">
        <button type="button" class="navbar__icon-btn navbar__cart" id="openCartBtn" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1" />
            <circle cx="20" cy="21" r="1" />
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
          </svg>
          <span class="navbar__cart-badge" id="cartBadge">0</span>
        </button>


        <% if (locals.currentUser) { %>
        <div class="profile-dropdown-wrapper">
          <button class="navbar__avatar-btn" id="avatarBtn" aria-label="User menu" aria-expanded="false">
            <% if (locals.currentUser.avatar) { %>
              <img src="<%= locals.currentUser.avatar %>" alt="User avatar" class="navbar__avatar" style="object-fit: cover; border-radius: 9999px;" />
            <% } else { %>
              <span class="navbar__avatar"><%= locals.currentUser.firstName ? locals.currentUser.firstName.charAt(0).toUpperCase() : 'U' %></span>
            <% } %>
            <svg class="navbar__avatar-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>

          <div class="profile-dropdown" id="profileDropdown">
            <div class="profile-dropdown__header">
              <p class="profile-dropdown__name"><%= locals.currentUser.firstName %> <%= locals.currentUser.lastName %></p>
              <p class="profile-dropdown__email"><%= locals.currentUser.email %></p>
            </div>
            <div class="profile-dropdown__divider"></div>
            <% if (locals.currentUser && (locals.currentUser.role === 'admin' || locals.userRole === 'admin')) { %>
            <a href="/admin" class="profile-dropdown__item profile-dropdown__item--admin">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span>Admin Dashboard</span>
            </a>
            <% } %>
            <a href="/settings" class="profile-dropdown__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3" />
                <path
                  d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
              </svg>
              <span>Settings</span>
            </a>
            <a href="/logout" class="profile-dropdown__item" onclick="localStorage.removeItem('userEmail'); localStorage.removeItem('userName'); localStorage.removeItem('theme'); document.documentElement.classList.remove('dark');">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              <span>Sign out</span>
            </a>
          </div>
        </div>
        <% } else { %>
        <a href="/login" class="navbar__login-btn">Login</a>
        <% } %>
      </div>
    </div>
  </header>


  <main class="settings-page page-main">
    <div class="settings-container">
      <header class="settings-header">
        <h1 class="settings-title">Account Settings</h1>
        <p class="settings-subtitle">Manage personal profile details, credentials, and workbench display preferences.</p>
        <% if (locals.currentUser && (locals.currentUser.role === 'admin' || locals.userRole === 'admin')) { %>
          <div class="settings-admin-bar">
            <a href="/admin" class="btn-settings-admin">Manage shop inventory &rarr;</a>
          </div>
        <% } %>
      </header>

      <div class="settings-main-col">
        <div class="settings-card">

          <div class="settings-row">
            <div class="settings-row__left">
              <span class="settings-row__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                  stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                  <circle cx="12" cy="7" r="4" />
                </svg>
              </span>
              <div class="settings-row__meta">
                <span class="settings-row__label">Name</span>
                <span class="settings-row__value" id="displayName"><%= locals.currentUser ? (locals.currentUser.firstName + ' ' + locals.currentUser.lastName) : 'Guest' %></span>
              </div>
            </div>
          </div>

          <div class="settings-card__divider"></div>


          <div class="settings-row">
            <div class="settings-row__left">
              <span class="settings-row__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                  stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              </span>
              <div class="settings-row__meta">
                <span class="settings-row__label">Email</span>
                <span class="settings-row__value" id="displayEmail"><%= locals.currentUser ? locals.currentUser.email : 'Not signed in' %></span>
              </div>
            </div>
          </div>

          <div class="settings-card__divider"></div>


          <div class="settings-row">
            <div class="settings-row__left">
              <span class="settings-row__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                  stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="4"/>
                  <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/>
                </svg>
              </span>
              <div class="settings-row__meta">
                <span class="settings-row__label">Username</span>
                <span class="settings-row__value" id="displayUsername"><%= locals.currentUser?.username ? ('@' + locals.currentUser.username) : 'No username set' %></span>
              </div>
            </div>
            <% if (locals.currentUser) { %>
            <div class="settings-row__right">
              <button type="button" class="btn-settings-action" id="openUsernameModalBtn">
                <span id="usernameBtnText"><%= locals.currentUser?.username ? 'Edit' : 'Add username' %></span>
              </button>
            </div>
            <% } %>
          </div>

          <div class="settings-card__divider"></div>


          <div class="settings-row">
            <div class="settings-row__left">
              <span class="settings-row__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                  stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </span>
              <div class="settings-row__meta">
                <span class="settings-row__label">Password</span>
                <span class="settings-row__value">••••••••••••</span>
              </div>
            </div>
            <% if (locals.currentUser) { %>
            <div class="settings-row__right">
              <button type="button" class="btn-settings-action" id="openPasswordModalBtn">
                <span>Change password</span>
              </button>
            </div>
            <% } %>
          </div>

          <div class="settings-card__divider"></div>


          <div class="settings-row">
            <div class="settings-row__left">
              <span class="settings-row__icon" id="appearanceIcon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                  stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="5" />
                  <line x1="12" y1="1" x2="12" y2="3" />
                  <line x1="12" y1="21" x2="12" y2="23" />
                  <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                  <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                  <line x1="1" y1="12" x2="3" y2="12" />
                  <line x1="21" y1="12" x2="23" y2="12" />
                  <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
                  <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
                </svg>
              </span>
              <div class="settings-row__meta">
                <span class="settings-row__label">Appearance</span>
                <span class="settings-row__value" id="themeModeText">Light mode</span>
              </div>
            </div>
            <div class="settings-row__right">
              <label class="toggle-switch">
                <input type="checkbox" id="themeToggleCheckbox" />
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>
        </div>


        <% if (locals.currentUser) { %>
        <a href="/logout" class="btn-signout" onclick="localStorage.removeItem('userEmail'); localStorage.removeItem('userName'); localStorage.removeItem('theme'); document.documentElement.classList.remove('dark');">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          <span>Sign out</span>
        </a>
        <% } else { %>
        <a href="/login" class="btn-signout">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
            <polyline points="10 17 15 12 10 7" />
            <line x1="15" y1="12" x2="3" y2="12" />
          </svg>
          <span>Sign in</span>
        </a>
        <% } %>
      </div>
    </div>
  </main>

  <div class="cart-drawer-backdrop" id="cartBackdrop" aria-hidden="true"></div>
  <aside class="cart-drawer" id="cartDrawer" aria-label="Shopping Cart" aria-hidden="true">
    <div class="cart-drawer__header">
      <div class="cart-drawer__title-wrap">
        <svg class="cart-drawer__bag-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
          <path d="M3 6h18" />
          <path d="M16 10a4 4 0 0 1-8 0" />
        </svg>
        <h2>Your Bundles</h2>
      </div>
      <button type="button" class="cart-drawer__close" id="closeCartBtn" aria-label="Close cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <div class="cart-drawer__body" id="cartDrawerBody"></div>

    <div class="cart-drawer__footer" id="cartDrawerFooter">
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <strong id="cartSubtotal">₱0.00</strong>
      </div>
      <div class="cart-drawer__notice">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
          stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2" />
          <path d="M7 8h10" />
          <path d="M7 12h10" />
          <path d="M7 16h6" />
        </svg>
        <span>Every bundle unlocks instant digital assets at checkout.</span>
      </div>
      <a href="/checkout" class="btn-checkout" id="checkoutBtn">
        Checkout · <span id="checkoutTotal">₱0.00</span>
      </a>
    </div>
  </aside>


  <footer class="footer">
    <div class="container footer__inner">
      <div class="footer__top">
        <div class="footer__brand-block">
          <div class="footer__logo">
            <span class="footer__logo-mark">
              <img src="/img/LK_light.png" alt="LabKit Logo" class="footer__logo-img footer__logo-img--light" width="28" height="28" />
              <img src="/img/LK_dark.png" alt="LabKit Logo" class="footer__logo-img footer__logo-img--dark" width="28" height="28" />
            </span>
            <span class="footer__brand-text">
              <span class="footer__wordmark-lab">Lab</span><span class="footer__wordmark-kit">Kit</span> Market
            </span>
          </div>
          <p class="footer__desc">
            Individual electronic components and IoT hardware for engineering students and makers. Buy single
            ESP32 boards, buzzers, sensors, and wiring &mdash; bench-checked with pinout datasheets included.
          </p>
        </div>

        <nav class="footer__links">
          <a href="/shop" class="footer__link">Shop</a>
          <a href="/about" class="footer__link">About Us</a>
          <a href="/#workbench" class="footer__link">Built for the workbench</a>
        </nav>
      </div>

      <div class="footer__bottom">
        <p>Copyright &copy; 2026 Alain Bibaoco and Andrea Caunga. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <!-- Username Modal -->
  <div class="settings-modal-backdrop is-hidden" id="usernameModalBackdrop">
    <div class="settings-modal" role="dialog" aria-labelledby="usernameModalTitle">
      <div class="settings-modal__header">
        <h3 class="settings-modal__title" id="usernameModalTitle">
          <%= locals.currentUser?.username ? 'Edit Username' : 'Add Username' %>
        </h3>
        <button type="button" class="settings-modal__close" id="closeUsernameModalBtn" aria-label="Close">&times;</button>
      </div>
      <form id="usernameForm" class="settings-modal__form">
        <p class="settings-modal__desc">Choose a unique username for your account. You can use this to sign in.</p>
        <div id="usernameAlertBox"></div>
        <div class="form-group">
          <label for="usernameInput" class="form-label">Username</label>
          <div class="input-wrap">
            <span class="input-prefix">@</span>
            <input 
              type="text" 
              id="usernameInput" 
              name="username" 
              class="form-input form-input--prefixed" 
              placeholder="username" 
              value="<%= locals.currentUser?.username || '' %>" 
              minlength="3" 
              maxlength="30" 
              pattern="^[a-zA-Z0-9_]{3,30}$" 
              required 
            />
          </div>
          <span class="form-helper">3–30 characters, letters, numbers, and underscores only.</span>
        </div>
        <div class="settings-modal__actions">
          <button type="button" class="btn-modal-cancel" id="cancelUsernameBtn">Cancel</button>
          <button type="submit" class="btn-modal-save" id="saveUsernameBtn">Save username</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Change Password Modal -->
  <div class="settings-modal-backdrop is-hidden" id="passwordModalBackdrop">
    <div class="settings-modal" role="dialog" aria-labelledby="passwordModalTitle">
      <div class="settings-modal__header">
        <h3 class="settings-modal__title" id="passwordModalTitle">Change Password</h3>
        <button type="button" class="settings-modal__close" id="closePasswordModalBtn" aria-label="Close">&times;</button>
      </div>
      <form id="passwordForm" class="settings-modal__form">
        <p class="settings-modal__desc">Set a new, secure password for your LabKit account.</p>
        <div id="passwordAlertBox"></div>
        
        <% if (locals.currentUser && locals.currentUser.hasPassword !== false) { %>
        <div class="form-group">
          <label for="currentPasswordInput" class="form-label">Current Password</label>
          <input 
            type="password" 
            id="currentPasswordInput" 
            name="currentPassword" 
            class="form-input" 
            placeholder="••••••••" 
            required 
            autocomplete="current-password"
          />
        </div>
        <% } %>

        <div class="form-group">
          <label for="newPasswordInput" class="form-label">New Password</label>
          <input 
            type="password" 
            id="newPasswordInput" 
            name="newPassword" 
            class="form-input" 
            placeholder="Min. 6 characters" 
            minlength="6" 
            required 
            autocomplete="new-password"
          />
        </div>

        <div class="form-group">
          <label for="confirmPasswordInput" class="form-label">Confirm New Password</label>
          <input 
            type="password" 
            id="confirmPasswordInput" 
            name="confirmPassword" 
            class="form-input" 
            placeholder="Re-enter new password" 
            minlength="6" 
            required 
            autocomplete="new-password"
          />
        </div>

        <div class="settings-modal__actions">
          <button type="button" class="btn-modal-cancel" id="cancelPasswordBtn">Cancel</button>
          <button type="submit" class="btn-modal-save" id="savePasswordBtn">Update password</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Settings Toast Container -->
  <div class="settings-toast-container" id="settingsToast"></div>

  <script src="/js/cart.js"></script>
  <script src="/js/navbar-search.js"></script>
  <script src="/js/settings.js"></script>
</body>

</html>