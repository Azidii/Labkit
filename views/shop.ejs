<!DOCTYPE html>
<html lang="en" data-auth="<%= locals.currentUser ? 'true' : 'false' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shop — LabKit Market</title>
  <meta name="description"
    content="Browse individual electronic parts. Buzzers, sensors, boards, motors and more — every part sold as a single unit, no minimum order." />
  <link rel="stylesheet" href="/css/shop.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/cart.css" />
  <link rel="stylesheet" href="/css/navbar-search.css" />
  <script src="/js/theme.js"></script>
  <script src="/js/page-transitions.js"></script>
</head>

<body>

  <!-- Navbar -->
  <header class="navbar">
    <div class="container navbar__inner">
      <a href="/" class="navbar__brand">
        <span class="navbar__logo-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <rect width="16" height="16" x="4" y="4" rx="2" />
            <rect width="6" height="6" x="9" y="9" />
            <path d="M15 2v2" />
            <path d="M15 20v2" />
            <path d="M2 15h2" />
            <path d="M2 9h2" />
            <path d="M20 15h2" />
            <path d="M20 9h2" />
            <path d="M9 2v2" />
            <path d="M9 20v2" />
          </svg>
        </span>
        <span class="navbar__wordmark">LabKit</span>
        <span class="navbar__sub">/MARKET</span>
      </a>

      <nav class="navbar__nav">
        <a href="/" class="navbar__link">Home</a>
        <a href="/shop" class="navbar__link navbar__link--active">Shop</a>
        <a href="/about" class="navbar__link">About Us</a>
        <% if (locals.currentUser && (locals.currentUser.role === 'admin' || locals.userRole === 'admin')) { %>
        <a href="/admin" class="navbar__link navbar__link--admin">Admin</a>
        <% } %>
      </nav>

      <div class="navbar__actions">
        <div class="navbar-search">
        <button type="button" class="navbar__icon-btn navbar-search__toggle" aria-label="Search" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </button>
        <form class="navbar-search__form" action="/shop" method="get" role="search">
          <input class="navbar-search__input" name="q" type="search" placeholder="Search products..." aria-label="Search products" />
        </form>
        </div>

        <button class="navbar__icon-btn navbar__cart" id="openCartBtn" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1" />
            <circle cx="20" cy="21" r="1" />
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" />
          </svg>
          <span class="navbar__cart-badge" id="cartBadge">0</span>
        </button>
        <% if (locals.currentUser) { %>
        <div class="profile-dropdown-wrapper">
          <button class="navbar__avatar-btn" id="avatarBtn" aria-label="User menu" aria-expanded="false">
            <% if (locals.currentUser.avatar) { %>
              <img src="<%= locals.currentUser.avatar %>" alt="User avatar" class="navbar__avatar" style="object-fit: cover; border-radius: 9999px;" />
            <% } else { %>
              <span class="navbar__avatar"><%= locals.currentUser.firstName ? locals.currentUser.firstName.charAt(0).toUpperCase() : 'U' %></span>
            <% } %>
            <svg class="navbar__avatar-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>

          <div class="profile-dropdown" id="profileDropdown">
            <div class="profile-dropdown__header">
              <p class="profile-dropdown__name"><%= locals.currentUser.firstName %> <%= locals.currentUser.lastName %></p>
              <p class="profile-dropdown__email"><%= locals.currentUser.email %></p>
            </div>
            <div class="profile-dropdown__divider"></div>
            <% if (locals.currentUser && (locals.currentUser.role === 'admin' || locals.userRole === 'admin')) { %>
            <a href="/admin" class="profile-dropdown__item profile-dropdown__item--admin">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
              <span>Admin Dashboard</span>
            </a>
            <% } %>
            <a href="/settings" class="profile-dropdown__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3" />
                <path
                  d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
              </svg>
              <span>Settings</span>
            </a>
            <a href="/logout" class="profile-dropdown__item" onclick="localStorage.removeItem('userEmail'); localStorage.removeItem('userName'); localStorage.removeItem('theme'); document.documentElement.classList.remove('dark');">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                <polyline points="16 17 21 12 16 7" />
                <line x1="21" y1="12" x2="9" y2="12" />
              </svg>
              <span>Sign out</span>
            </a>
          </div>
        </div>
        <% } else { %>
        <a href="/login" class="navbar__login-btn">Login</a>
        <% } %>
      </div>
    </div>
  </header>

  <!-- Shop Content -->
  <main class="shop-page container page-main">
    <div class="shop-header">
      <div class="shop-header__content">
        <h1 class="shop-title">Hardware parts for your bench</h1>
        <p class="shop-subtitle">
          Tested individual parts for student benches and IoT prototypes. Buzzers, sensors, boards, motors and wiring sold as single units with zero minimum order.
        </p>
      </div>
      <figure class="shop-header__figure">
        <img src="/img/electronics-workbench.jpg" alt="Lab bench hardware components and test instrumentation" class="shop-header__img" width="480" height="240" />
      </figure>
    </div>

    <!-- Search Bar -->
    <form action="/shop" method="GET" class="shop-search-form" id="filterForm">
      <input type="hidden" name="category" value="<%= activeCategory %>" id="categoryInput" />
      <input type="hidden" name="difficulty" value="<%= activeDifficulty %>" id="difficultyInput" />

      <div class="search-wrap">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <input type="search" name="q" id="searchInput" class="search-input"
          placeholder="Search products..." value="<%= searchQuery %>" />
        <button type="submit" class="search-submit" aria-label="Search products">
          <span>Search</span>
        </button>
      </div>
      <div class="search-suggestions" id="searchSuggestions" role="listbox"
        aria-label="Product suggestions" hidden></div>
    </form>

    <div class="shop-layout">
      <!-- Sidebar Filters -->
      <aside class="shop-sidebar">
        <div class="sidebar-header">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
          </svg>
          <span class="sidebar-header__text">Filters</span>
        </div>

        <div class="sidebar-section">
          <h2 class="sidebar-heading">Component category</h2>
          <div class="filter-group">
            <% const cats=["All", "IoT Kits", "Microcontrollers", "Single-Board Computers", "Sensors & Modules"
              , "Buzzers & Audio", "Motors & Actuators", "Displays & Power"]; %>
              <% cats.forEach(c=> { %>
                <button type="button" class="filter-pill <%= activeCategory === c ? 'is-active' : '' %>"
                  onclick="setFilter('category', '<%= c %>')">
                  <%= c %>
                </button>
                <% }) %>
          </div>
        </div>

        <div class="sidebar-section">
          <h2 class="sidebar-heading">Difficulty level</h2>
          <div class="filter-group">
            <% const diffs=["All levels", "Beginner" , "Intermediate" , "Advanced" ]; %>
              <% diffs.forEach(d=> { %>
                <button type="button" class="filter-pill <%= activeDifficulty === d ? 'is-active' : '' %>"
                  onclick="setFilter('difficulty', '<%= d %>')">
                  <%= d %>
                </button>
                <% }) %>
          </div>
        </div>

        <% if (activeCategory !=='All' || activeDifficulty !=='All levels' || searchQuery) { %>
          <a href="/shop" class="btn-clear-filters">
            Reset all filters
          </a>
          <% } %>
      </aside>

      <!-- Products Grid -->
      <section class="shop-products">
        <div class="results-bar">
          <span class="results-count"><strong>
              <%= totalCount %>
            </strong> items</span>
          <div class="results-sort">
            <label for="sortSelect">Sort</label>
            <div class="sort-menu" id="sortMenu">
              <button type="button" class="sort-select" id="sortSelect" aria-haspopup="listbox"
                aria-expanded="false">
                <span id="sortSelectLabel">
                  <%= activeSort==='price-asc' ? 'Price: Low to High' : activeSort==='price-desc' ? 'Price: High to Low' : 'Featured' %>
                </span>
                <span class="sort-select__chevron" aria-hidden="true"></span>
              </button>
              <div class="sort-options" id="sortOptions" role="listbox" aria-label="Sort products" hidden>
                <button type="button" class="sort-option <%= activeSort==='featured' ? 'is-active' : '' %>"
                  role="option" aria-selected="<%= activeSort==='featured' %>" data-value="featured">Featured</button>
                <button type="button" class="sort-option <%= activeSort==='price-asc' ? 'is-active' : '' %>"
                  role="option" aria-selected="<%= activeSort==='price-asc' %>" data-value="price-asc">Price: Low to High</button>
                <button type="button" class="sort-option <%= activeSort==='price-desc' ? 'is-active' : '' %>"
                  role="option" aria-selected="<%= activeSort==='price-desc' %>" data-value="price-desc">Price: High to Low</button>
              </div>
            </div>
          </div>
        </div>

        <% if (!products || products.length===0) { %>
          <div class="empty-state">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
              <line x1="8" y1="11" x2="14" y2="11" />
            </svg>
            <% if (activeCategory !== 'All' || activeDifficulty !== 'All levels' || searchQuery) { %>
              <h3>No parts match your criteria</h3>
              <p>Try clearing your active filters or searching for another keyword.</p>
              <a href="/shop" class="btn-clear-filters">Clear all filters</a>
            <% } else { %>
              <h3>No products available yet</h3>
              <p>Items added via the admin panel will appear here in the shop catalog.</p>
              <% if (locals.currentUser && (locals.currentUser.role === 'admin' || locals.userRole === 'admin')) { %>
                <a href="/admin" class="btn-clear-filters" style="display: inline-flex; align-items: center; gap: 0.4rem;">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                  Add items in Admin Console
                </a>
              <% } %>
            <% } %>
          </div>
          <% } else { %>
            <div class="product-grid">
              <% products.forEach(p=> { %>
                <div class="product-card" id="product-<%= p.slug || p.id %>" data-slug="<%= p.slug %>"
                  data-search="<%= [p.name, p.tagline, p.description, p.category].filter(Boolean).join(' ').replace(/&/g, '&amp;').replace(/"/g, '&quot;') %>">
                  <div class="product-card__img-wrap">
                    <div class="product-card__badges">
                      <span class="product-card__cat-badge">
                        <%= p.category %>
                      </span>
                      <% if (p.difficulty) { %>
                        <span
                          class="product-card__diff-badge product-card__diff-badge--<%= p.difficulty.toLowerCase().replace(/\s/g, '-') %>">
                          <%= p.difficulty %>
                        </span>
                        <% } %>
                    </div>
                    <img src="<%= p.image_url %>" alt="<%= p.name %>" loading="lazy" />
                  </div>
                  <div class="product-card__body">
                    <h3 class="product-card__name">
                      <%= p.name %>
                    </h3>
                    <p class="product-card__tagline">
                      <%= p.tagline %>
                    </p>
                    <div class="product-card__meta">
                      <span class="product-card__rating">
                        <svg class="product-card__star-icon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                        <span><%= p.rating ? p.rating.toFixed(1) : '—' %></span>
                        <span class="product-card__review-count">(<%= p.review_count %>)</span>
                      </span>
                      <% const currentStock = Number(p.stock !== undefined ? p.stock : (p.stockQuantity !== undefined ? p.stockQuantity : 0)); %>
                      <% if (currentStock <= 0) { %>
                        <span class="product-card__stock-tag product-card__stock-tag--out">
                          <span class="stock-dot stock-dot--out"></span>
                          Out of stock
                        </span>
                      <% } else if (currentStock <= 5) { %>
                        <span class="product-card__stock-tag product-card__stock-tag--low">
                          <span class="stock-dot stock-dot--low"></span>
                          Only <%= currentStock %> left
                        </span>
                      <% } else { %>
                        <span class="product-card__stock-tag product-card__stock-tag--in">
                          <span class="stock-dot stock-dot--in"></span>
                          <%= currentStock %> left in stock
                        </span>
                      <% } %>
                    </div>
                    <div class="product-card__footer">
                      <span class="product-card__price">₱<%= p.price.toFixed(2) %></span>
                      <% if (currentStock > 0) { %>
                        <button type="button" class="product-card__add-btn js-add-to-cart"
                          data-id="<%= p.id %>"
                          data-name="<%= (p.name || '').replace(/["']/g, '') %>"
                          data-price="<%= p.price %>"
                          data-img="<%= p.image_url %>"
                          data-type="<%= p.productType || 'item' %>"
                          data-stock="<%= currentStock %>"
                          data-max="<%= currentStock %>"
                          aria-label="Add to cart">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19" />
                            <line x1="5" y1="12" x2="19" y2="12" />
                          </svg>
                        </button>
                      <% } else { %>
                        <button type="button" class="product-card__add-btn is-sold-out" disabled aria-label="Sold out" title="Out of stock">
                          <span class="sold-out-text">Sold out</span>
                        </button>
                      <% } %>
                    </div>
                  </div>
                </div>
                <% }) %>
            </div>
            <% } %>
      </section>
    </div>
  </main>

  <!-- Cart Drawer -->
  <div class="cart-drawer-backdrop" id="cartBackdrop" aria-hidden="true"></div>
  <aside class="cart-drawer" id="cartDrawer" aria-label="Shopping Cart" aria-hidden="true">
    <div class="cart-drawer__header">
      <div class="cart-drawer__title-wrap">
        <svg class="cart-drawer__bag-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
          <path d="M3 6h18" />
          <path d="M16 10a4 4 0 0 1-8 0" />
        </svg>
        <h2>Your Cart</h2>
      </div>
      <button type="button" class="cart-drawer__close" id="closeCartBtn" aria-label="Close cart">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <div class="cart-drawer__body" id="cartDrawerBody"></div>

    <div class="cart-drawer__footer" id="cartDrawerFooter">
      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <strong id="cartSubtotal">₱0.00</strong>
      </div>
      <div class="cart-drawer__notice">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
          stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2" />
          <path d="M7 8h10" />
          <path d="M7 12h10" />
          <path d="M7 16h6" />
        </svg>
        <span>Every part ships with datasheets and pinout diagrams.</span>
      </div>
      <a href="/checkout" class="btn-checkout" id="checkoutBtn">
        Checkout · <span id="checkoutTotal">₱0.00</span>
      </a>
    </div>
  </aside>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer__inner">
      <div class="footer__top">
        <div class="footer__brand-block">
          <div class="footer__logo">
            <span class="navbar__logo-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round">
                <rect width="16" height="16" x="4" y="4" rx="2" />
                <rect width="6" height="6" x="9" y="9" />
                <path d="M15 2v2" />
                <path d="M15 20v2" />
                <path d="M2 15h2" />
                <path d="M2 9h2" />
                <path d="M20 15h2" />
                <path d="M20 9h2" />
                <path d="M9 2v2" />
                <path d="M9 20v2" />
              </svg>
            </span>
            <span class="footer__brand-text">LabKit Market</span>
          </div>
          <p class="footer__desc">
            Individual electronic parts for engineering students and
            hobbyists — buzzers, sensors, boards, motors and more.
            Every part is sold as a single unit, tested before it ships, with
            no minimum order.
          </p>
        </div>

        <nav class="footer__links">
          <a href="/shop" class="footer__link">Shop</a>
          <a href="/about" class="footer__link">About Us</a>
          <a href="/#workbench" class="footer__link">Built for the workbench</a>
        </nav>
      </div>

      <div class="footer__bottom">
        <p>Copyright &copy; 2026 Alain Bibaoco and Andrea Caunga. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <script src="/js/cart.js"></script>
  <script src="/js/navbar-search.js"></script>
  <script type="application/json" id="shopSuggestionData"><%- typeof suggestionProductsJson !== 'undefined' ? suggestionProductsJson : '[]' %></script>
  <script src="/js/shop.js"></script>
</body>

</html>